#!/bin/bash
# machogs — find out what is hogging your Mac.
#
# Slow, hot, loud fan, battery gone by lunch: usually one program eating a CPU
# core that nobody is using any more. This finds it and tells you in plain words.
#
#   machogs                 plain answer (default, never closes anything)
#   machogs fix             go through them one at a time, asking before each
#   machogs blame           scoreboard: which app leaves the most junk behind
#   machogs brag            a shareable card of what your Mac has wasted
#   machogs disk            where your storage went (report-only, deletes nothing)
#   machogs memory          which APPS hold your memory, and who is hoarding it
#   machogs energy          which APPS are eating your battery, in minutes/hour
#   machogs ports           every port in use and what is squatting it
#   machogs port 3000       who holds port 3000;  add `kill` to free it
#   machogs --details       the technical report, by category
#   machogs kill            close everything reapable, no questions (scripts)
#   machogs kill --dupes    also close duplicate MCP servers (keeps newest)
#   machogs plan --target=123:ID  recheck reviewed process identities (app JSON)
#   machogs kill --target=123:ID  close only identities returned by a fresh plan
#   machogs --sessions      list Claude Code sessions too (never closed)
#   machogs --json          machine-readable output, for agents (see below)
#
# FOR AGENTS: `--json` prints one JSON object on stdout and nothing else, so it
# can be parsed without scraping colours or column layout. Exit codes carry the
# verdict, so a wrapper does not have to parse anything at all:
#   0  clean — nothing worth reaping (or: kill finished)
#  10  findings exist, report mode — a human should look
#   2  bad arguments
# --json is a reporting flag. It never kills on its own; pair it with `kill`.
#
# SAFETY RULES, in order of importance:
#   1. Never kills anything in this script's own process ancestry.
#   2. Never kills a Claude Code session. Ever. It only reports them.
#      (You code in the Claude app — killing a session loses live work.)
#   3. Report mode is the default. `kill` is always explicit.
#
# Section 1 only catches runaways whose PARENT DIED. That missed the real
# thing (a plugin server spinning at 90% for four days under a live wrapper),
# so section 1b catches spinners whose parent is alive, using accumulated CPU
# TIME rather than parentage: hot right now AND hours of CPU burned = stuck.
#
# Supersedes debug-bun (bun + zombie apps only). Logs kills to
# ~/Library/Logs/machogs.log
set -uo pipefail

# ---- config ---------------------------------------------------------------
# Both are env-overridable so the detector can be exercised without waiting
# four hours for a real spinner:  SPIN_CPU_SECONDS=5 machogs
HOT_CPU=${HOT_CPU:-50}                 # %CPU above which a process counts as hot
SPIN_CPU_SECONDS=${SPIN_CPU_SECONDS:-14400}  # 4h CPU + hot now = stuck, not busy
ORPHAN_MIN_SECONDS=${ORPHAN_MIN_SECONDS:-300} # an orphan must have lasted 5 min
IDLE_SESSION_MINS=180      # a Claude Code session idle this long gets flagged
# Memory thresholds. `ps -o rss` is deliberately never used here: the process
# that motivated these held 7,102 MB while its RSS read 357 MB — macOS had
# compressed the rest out to disk, where ps cannot see it but your Mac still
# pays for it. phys_footprint (top's MEM column) is the number Activity
# Monitor and the Force Quit dialog show, so it is the number used here.
MEM_HOG_MB=${MEM_HOG_MB:-1024}         # one idle process holding this much is a hog
MEM_HOG_MAX_CPU=${MEM_HOG_MAX_CPU:-5}  # above this %CPU it is working, not hoarding
MEM_HOG_MIN_SECONDS=${MEM_HOG_MIN_SECONDS:-3600} # young processes get an hour of grace
CLONE_COUNT=${CLONE_COUNT:-8}          # same-named siblings before they are an army
MEM_APP_MB=${MEM_APP_MB:-4096}         # a whole APP worth flagging in `machogs memory`
MEM_COLD_PCT=${MEM_COLD_PCT:-60}       # this much of it compressed cold = hoarding
MEM_COLD_MARGIN=${MEM_COLD_MARGIN:-15} # ...and this far above the machine baseline
MEM_APP_PROCS=${MEM_APP_PROCS:-20}     # or simply this many processes for one app
# Battery arithmetic. Apple silicon: a core at full tilt costs roughly 6W,
# against a machine that idles near 8W — the same two figures the receipt's
# battery line is built on. They only ever split a drain into shares; neither
# number is ever printed, because nobody thinks about their laptop in watts.
WATTS_IDLE=${WATTS_IDLE:-8}            # what the Mac costs with nothing running
WATTS_PER_CORE=${WATTS_PER_CORE:-6}    # ...and what one core at full tilt adds
# A battery drainer worth naming: costing real minutes AND doing it steadily.
# The second half is what stops the report slandering the app you are using —
# a foreground app you just gave work to is expensive for a minute; the one to
# tell someone about has been expensive for its whole life.
ENERGY_APP_MINS=${ENERGY_APP_MINS:-10}      # minutes of battery an hour it costs
ENERGY_SUSTAIN_PCT=${ENERGY_SUSTAIN_PCT:-25} # ...averaged over its whole lifetime
ENERGY_MIN_SECONDS=${ENERGY_MIN_SECONDS:-1800} # young apps get half an hour of grace
# Processes that legitimately pin a core for hours — or, for the memory
# sections, legitimately hold gigabytes: a virtual machine's footprint IS the
# guest's RAM, and closing one can lose unsaved work inside it. Matched
# against ucomm.
NEVER_SPIN="WindowServer|kernel_task|launchd|ffmpeg|HandBrake|Compressor|backupd|mds|mds_stores|mdworker|photoanalysisd|com.apple.Virtua|qemu|Docker|com.docker"
# Never blamed for battery, because blaming them is noise. WindowServer is the
# #1 energy consumer on every Mac ever made: it is the display compositor, and
# its cost is really the sum of what every app asks it to draw. Same for the
# audio daemon (it plays what an app asked it to play), the kernel, and pid 1.
# None of them can be quit, and none of them are the answer to "what is eating
# my battery". They are left out of the ranking AND out of the total, which
# hands their cost back to the apps causing it, in proportion. Note this list
# is deliberately NOT NEVER_SPIN: a video encode legitimately pins a core for
# hours and is exempt there, but it is absolutely draining your battery and a
# person deserves to be told so.
NEVER_BLAME="WindowServer|kernel_task|launchd|coreaudiod|hidd|powerd|sysmond|^top$"
ZOMBIE_APPS=("Cursor" "Code" "Electron")   # apps that leak helpers after quitting
# process patterns treated as "MCP / automation servers"
MCP_PATTERNS="playwright-mcp|@playwright/mcp|mcp-server-|/mcp/server\.(c|m)?js|modelcontextprotocol"
HEADLESS_PATTERNS="chrome-headless-shell|--headless"
# Browser/Electron child processes always carry --type=. They are never MCP
# servers, even when their --user-data-dir path happens to contain "mcp".
NOT_MCP="--type=|Google Chrome|Chromium|chrome-headless-shell"

LOG="$HOME/Library/Logs/machogs.log"
TAB=$'\t'
RED=$'\033[0;31m'; GRN=$'\033[0;32m'; YLW=$'\033[0;33m'; BLU=$'\033[0;34m'
DIM=$'\033[2m'; BLD=$'\033[1m'; NC=$'\033[0m'
[ -t 1 ] || { RED=; GRN=; YLW=; BLU=; DIM=; BLD=; NC=; }

# Emoji follow the same rule as colour: gone when piped, so scripts and agents
# never see them. Exception: the brag card keeps its emoji even piped, because
# the pasted card IS the product.
E_PIG="🐷 "; E_OK="✨ "; E_FIRE="🔥 "; E_ZZZ="💤 "; E_CLONE="👯 "
E_PARTY="🎉 "; E_ZAP="⚡ "; E_BROOM="🧹 "; E_CROWN=" 👑"
[ -t 1 ] || { E_PIG=; E_OK=; E_FIRE=; E_ZZZ=; E_CLONE=; E_PARTY=; E_ZAP=; E_BROOM=; E_CROWN=; }

MODE=report; DUPES=0; SHOW_SESSIONS=0; JSON=0; DETAILS=0; PORTS=0; MEMORY=0; ENERGY=0; PORT_NUM=""; CLEAR_PATH=""; TARGETS=""
for a in "$@"; do
  case "$a" in
    kill)        MODE=kill ;;
    plan)        MODE=plan ;;
    ports|port)  PORTS=1 ;;
    memory)      MEMORY=1 ;;
    energy)      ENERGY=1 ;;
    fix)         MODE=fix ;;
    blame)       MODE=blame ;;
    brag)        MODE=brag ;;
    disk)        MODE=disk ;;
    clear)       if [ "$MODE" = disk ] || [ "$MODE" = clear-pending ]; then MODE=clear-pending; else
                   echo "clear goes with disk: machogs disk clear <path>" >&2; exit 2; fi ;;
    /*|~*)       if [ "$MODE" = clear-pending ]; then CLEAR_PATH=$a; else
                   echo "unknown arg: $a (try --help)" >&2; exit 2; fi ;;
    [0-9]*)      if [ "$PORTS" -eq 1 ]; then PORT_NUM=$a; else
                   echo "unknown arg: $a (try --help)" >&2; exit 2; fi ;;
    --dupes)     DUPES=1 ;;
    --target=*)
      target=${a#--target=}; target_pid=${target%%:*}; target_id=${target#*:}
      case "$target_pid:$target_id" in
        ''|*[!0-9:]*|0:*|*:|*:*:*) echo "bad target: $target" >&2; exit 2 ;;
      esac
      TARGETS="$TARGETS $target"
      ;;
    --sessions)  SHOW_SESSIONS=1 ;;
    --check)     MODE=check ;;
    --json)      JSON=1 ;;
    --details)   DETAILS=1 ;;
    -h|--help)   sed -n '2,36p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $a (try --help)" >&2; exit 2 ;;
  esac
done

if [ -n "$TARGETS" ] && [ "$MODE" != kill ] && [ "$MODE" != plan ]; then
  echo "--target goes with plan or kill" >&2
  exit 2
fi
if [ "$MODE" = plan ] && { [ -z "$TARGETS" ] || [ "$JSON" -ne 1 ]; }; then
  echo "plan needs --json and at least one --target=PID:IDENTITY" >&2
  exit 2
fi

# `fix` confirms every single close with the person sitting there, so the
# --dupes gate is redundant: it exists to stop unattended runs reaping things
# nobody looked at. An attended run looks at all of them.
[ "$MODE" = fix ] && DUPES=1
[ "$MODE" = plan ] && DUPES=1

# Plain language is the default. --details, --json and --check are the ways to
# ask for the technical view instead.
HUMAN=1
if [ "$DETAILS" -eq 1 ] || [ "$JSON" -eq 1 ] || [ "$MODE" = check ]; then HUMAN=0; fi
if [ "$MODE" = fix ]; then HUMAN=1; fi

if [ "$MODE" = fix ] && [ ! -t 0 ]; then
  echo "machogs fix needs a terminal to ask you questions." >&2
  echo "For unattended use run: machogs kill" >&2
  exit 2
fi

# Findings are always recorded to a scratch file, whether or not --json was
# asked for; it costs nothing and keeps the reporting code in one place.
ROWS=$(mktemp -t machogs-rows) || exit 1
GRP=$(mktemp -t machogs-groups) || exit 1
trap 'rm -f "$ROWS" "$GRP"' EXIT

# row <pid> <category> <action> <cpu> <age> <detail>
# Tab-separated. Nothing here may contain a tab or newline; the fields are all
# pids, numbers, and process names, so that holds. New fields are append-only:
# readers that stop at identity keep working, because in `read` the last
# variable swallows the remainder and none of them use identity's tail.
row() { printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$(cputime_of "$1")" "$(identity_of "$1")" "$(footprint_of "$1")" >> "$ROWS"; }

# Total CPU seconds this process has consumed since it started.
cputime_of() { cpusecs "$(ps -o time= -p "$1" 2>/dev/null | tr -d ' ')"; }

# The log is the scoreboard. Written tab-separated so `machogs blame` can add
# it up months later: when, pid, which app is to blame, what it was, and what
# it cost. Free-text log lines from older versions still parse — badly — so
# blame treats anything it cannot read as "unknown".
# logclose <pid> <owner> <what> <cpu%> <cpu-seconds>
logclose() {
  local owner=${2:-unknown}; [ "$owner" = "-" ] && owner="unknown"
  printf '%s\tclosed\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date '+%F %T')" "$1" "$owner" "${3:-program}" "${4:-0}" "${5:-0}" >> "$LOG"
}

# ---- plain language -------------------------------------------------------
# Everything below exists to answer one question a normal person actually asks:
# "what is this thing and is it safe to close?" A pid and a percentage do not
# answer that. The name of the app that left it behind does.

# Two separate questions, because the answers come from different places:
# WHAT is this thing, and WHICH APP left it here. "node" answers neither.
# The owning app is the useful half — it is the thing the person recognises
# and, usually, the thing they should quit or update.

hay_for() {
  local pid=$1
  printf '%s %s %s' \
    "$(ps -o command= -p "$pid" 2>/dev/null)" \
    "$(lsof -p "$pid" -a -d cwd 2>/dev/null | tail -1 | awk '{print $NF}')" \
    "$(ps -o command= -p "$(root_of "$pid")" 2>/dev/null)"
}

# Which app is responsible. Checked before what-it-is, because an app name
# beats a category every time.
whose() {
  case "$(hay_for "$1")" in
    *ChatGPT*)                  echo "ChatGPT" ;;
    *[Cc]odex*)                 echo "Codex" ;;
    *.claude/plugins*)          echo "a Claude Code plugin" ;;
    *claude-code*|*Claude.app*) echo "Claude Code" ;;
    *Cursor*)                   echo "Cursor" ;;
    *[Ww]indsurf*)              echo "Windsurf" ;;
    *Visual\ Studio\ Code*|*/Code\ Helper*) echo "VS Code" ;;
    *) echo "" ;;
  esac
}

# What kind of thing it is, in words rather than process names.
whatis() {
  local pid=$1
  case "$(hay_for "$pid")" in
    *playwright*)          echo "browser-control helper" ;;
    *chrome-headless*)     echo "hidden browser window" ;;
    *mcp*|*modelcontext*)  echo "AI tool helper" ;;
    *crashpad*)            echo "crash reporter" ;;
    *) local n; n=$(ps -o ucomm= -p "$pid" 2>/dev/null | sed 's/ *$//')
       echo "${n:-background program}" ;;
  esac
}

# etime -> seconds. Formats: "00:01", "01:29:07", "04-01:37:50".
etime_secs() {
  echo "$1" | awk -F- '
    { t = (NF==2 ? $2 : $1); d = (NF==2 ? $1 : 0)
      n = split(t, a, ":")
      s = (n==3 ? a[1]*3600 + a[2]*60 + a[3] : a[1]*60 + a[2])
      printf "%d", d*86400 + s }'
}

# n + unit, pluralised, no leading zeros. "04" -> "4 days", "1" -> "1 day".
count_unit() {
  local d; d=$(printf '%s' "${1:-0}" | tr -cd '0-9'); [ -n "$d" ] || d=0
  local n=$((10#$d)) u=$2
  [ "$n" -eq 1 ] && { echo "1 $u"; return; }
  # "process" pluralises with -es, and "2 processs" reads like a typo the
  # person will trust less than the number next to it
  case "$u" in *s|*x|*ch|*sh) echo "$n ${u}es" ;; *) echo "$n ${u}s" ;; esac
}

# "04-01:37:50" (4 days) or "01:29:07" (1.5 hours) -> words.
plain_age() {
  case "$1" in
    *-*)   count_unit "$(echo "$1" | cut -d- -f1)" day ;;
    *:*:*) count_unit "$(echo "$1" | cut -d: -f1)" hour ;;
    *)     local m; m=$(count_unit "$(echo "$1" | cut -d: -f1)" minute)
           # "0 minutes" reads like a bug; a brand-new process is just young
           [ "$m" = "0 minutes" ] && m="under a minute"
           echo "$m" ;;
  esac
}

# What a section means for the person, not for the process table.
why_line() {
  case "$1" in
    1)  echo "It kept running after the app that started it closed." ;;
    1b) echo "It is stuck in a loop. Nothing is waiting for it." ;;
    2)  echo "The app that started it is gone, but it never stopped." ;;
    2b) echo "A duplicate. One app started the same helper many times over." ;;
    3)  echo "A hidden browser window nobody is looking at." ;;
    4)  echo "The app was closed, but this piece of it stayed behind." ;;
    6)  echo "It is not working — just sitting on a big block of memory." ;;
    6b) echo "Each copy is small. Together they add up to real memory." ;;
    *)  echo "" ;;
  esac
}

# ---- stories ---------------------------------------------------------------
# The tool knows the good version of the sentence. If it does not say it, every
# agent invents its own and most of them are flat. story() is the line meant to
# be repeated out loud, to a person, verbatim.

# 328000 -> "91 hours". 5400 -> "1.5 hours". 300 -> "5 minutes".
burned() {
  awk -v s="${1:-0}" 'BEGIN{
    if (s >= 864000) { printf "%.0f days", s/86400 }
    else if (s >= 7200) { printf "%d hours", s/3600 }
    else if (s >= 3600) { printf "1 hour" }
    else if (s >= 120) { printf "%d minutes", s/60 }
    else if (s >= 60) { printf "1 minute" }
    else { printf "%d seconds", s }
  }'
}

# CPU seconds -> whole phone charges (see the note in receipt for the math).
phone_charges() { awk -v s="${1:-0}" 'BEGIN{printf "%d", s/9000}'; }

# 7102 -> "6.9 GB". 512 -> "512 MB". Megabytes are the working unit everywhere
# else in this file; gigabytes only appear here, at the moment of speaking.
mem_words() { awk -v m="${1:-0}" 'BEGIN{ if (m >= 1024) printf "%.1f GB", m/1024; else printf "%d MB", m }'; }

# 4.07 -> "about 4 minutes an hour". The only form a battery cost is ever
# spoken in. macOS's own answer to this question is "Energy Impact: 32.4",
# which tells a person nothing they can feel; minutes of their afternoon does.
# Anything under a minute is named rather than rounded, because "0 minutes an
# hour" reads like the tool failed to measure it.
mins_words() {
  awk -v m="${1:-0}" 'BEGIN{
    if (m < 1) { printf "under a minute" }
    else if (m < 1.5) { printf "about a minute" }
    else { printf "about %d minutes", m + 0.5 } }'
}
drain_words() { printf '%s an hour' "$(mins_words "$1")"; }

# "3:10" from pmset -> "about 3 hours 10 minutes". Empty in, empty out: macOS
# refuses to estimate for the first minutes after a plug change, and inventing
# a number there would be the one thing worse than saying nothing.
time_left_words() {
  case "${1:-}" in
    *:*) awk -F: -v h="${1%%:*}" -v m="${1##*:}" 'BEGIN{
           h += 0; m += 0
           if (h > 0) printf "about %d hour%s %d minutes", h, (h == 1 ? "" : "s"), m
           else printf "about %d minutes", m }' ;;
    *)   echo "" ;;
  esac
}

article() {
  local a="A"; [ "${2:-}" = lower ] && a="a"
  case "$1" in [AaEeIiOoUu]*) echo "${a}n" ;; *) echo "$a" ;; esac
}

# story <sec> <what> <owner> <count> <cpu> <age> <cpusecs> [memMB]
# Always ends up capitalised — the owner can legitimately be "a Claude Code
# plugin", which would otherwise start the sentence in lower case.
story() { _story "$@" | awk '{ print toupper(substr($0,1,1)) substr($0,2) }' | tr -d '\n'; }
_story() {
  local sec=$1 what=$2 owner=$3 count=$4 cpu=$5 age=$6 csec=$7 mem=${8:-0}
  [ "$owner" = "-" ] && owner=""
  if [ "$sec" = "5" ]; then
    printf 'One of your live Claude Code sessions, running %s. Never closed by this tool.' \
      "$(plain_age "$age")"
    return
  fi
  local who="Something"; [ -n "$owner" ] && who="$owner"
  local ci=${cpu%.*}

  # Memory findings never reach the CPU sentences below: a hog is by
  # definition idle, so "burned N seconds" would be a punchline about nothing.
  # The memory amount IS the story.
  if [ "$sec" = "6" ]; then
    if [ -n "$owner" ]; then
      printf '%s left %s %s sitting on %s of memory for %s without doing anything.' \
        "$who" "$(article "$what" lower)" "$what" "$(mem_words "$mem")" "$(plain_age "$age")"
    else
      printf '%s %s has been sitting on %s of memory for %s without doing anything.' \
        "$(article "$what")" "$what" "$(mem_words "$mem")" "$(plain_age "$age")"
    fi
    return
  fi
  if [ "$sec" = "6b" ]; then
    printf '%s kept starting copies of the same %s and never cleaned any up. Each one is small; the pile is eating your memory.' \
      "$who" "$what"
    return
  fi

  if [ "${ci:-0}" -ge 20 ]; then
    # the headline case: it is on fire, and the burned total is the punchline
    if [ -n "$owner" ]; then
      printf '%s left %s %s running at %s%% of a CPU core for %s. It has burned %s of processor time.' \
        "$who" "$(article "$what" lower)" "$what" "$cpu" "$(plain_age "$age")" "$(burned "$csec")"
    else
      printf '%s %s is stuck at %s%% of a CPU core and has been for %s, burning %s of processor time.' \
        "$(article "$what")" "$what" "$cpu" "$(plain_age "$age")" "$(burned "$csec")"
    fi
  elif [ "$count" -gt 1 ]; then
    printf '%s quietly started %s copies of the same %s. All idle, none cleaned up, oldest sitting there %s.' \
      "$who" "$count" "$what" "$(plain_age "$age")"
  elif [ -n "$owner" ]; then
    printf '%s left %s %s behind. Idle for %s, and nothing is using it.' \
      "$who" "$(article "$what" lower)" "$what" "$(plain_age "$age")"
  else
    printf '%s %s has been idle for %s with nothing using it.' "$(article "$what")" "$what" "$(plain_age "$age")"
  fi
}

# The receipt. Closing a process is an event; getting a core back is a result.
# Same action, and only one of them is worth telling someone about.
#
# The battery line is an ESTIMATE and says so. A core at full tilt costs roughly
# 6W on Apple silicon, against a machine that idles near 8W, so freeing a full
# core really is worth hours — but it depends on the Mac, so we never print a
# precise number we cannot stand behind.
receipt() {
  local cpu_freed=$1 csec_freed=$2 nclosed=$3
  local cores; cores=$(awk -v c="${cpu_freed:-0}" 'BEGIN{printf "%.1f", c/100}')
  echo
  echo "${E_PARTY}${GRN}${BLD}Closed $(count_unit "$nclosed" program).${NC}"
  if [ "$(awk -v c="${cores:-0}" 'BEGIN{print (c>=0.2)?1:0}')" = "1" ]; then
    echo "You just got back ${BLD}${cores} of a CPU core${NC} that nothing was using."
  fi
  if [ "${csec_freed:-0}" -ge 600 ]; then
    echo "They had already burned ${BLD}$(burned "$csec_freed")${NC} of processor time."
  fi
  # CPU seconds -> phone charges, so the waste is a thing you can hold:
  # a core flat out ≈ 6W, so csec/3600*6 Wh; a phone battery ≈ 15Wh -> csec/9000.
  # Rough on purpose, and only shown once it is comfortably past one charge.
  local charges; charges=$(phone_charges "$csec_freed")
  if [ "${charges:-0}" -ge 2 ]; then
    echo "${E_ZAP}The electricity they wasted could have charged your phone ${BLD}about $charges times${NC}."
  fi
  # what it would have cost by tomorrow if left alone
  if [ "$(awk -v c="${cpu_freed:-0}" 'BEGIN{print (c>=20)?1:0}')" = "1" ]; then
    local tomorrow; tomorrow=$(awk -v c="$cpu_freed" 'BEGIN{printf "%d", (c/100)*86400}')
    echo "Left alone, they would have burned ${BLD}$(burned "$tomorrow")${NC} more by this time tomorrow."
    echo "${DIM}Roughly an hour or two of battery back, depending on your Mac.${NC}"
  fi
}

# One GROUP of identical findings, as a few lines of English. Seven copies of
# the same leaked helper is one problem, not seven, and reading it seven times
# teaches the person nothing.
say_group() {
  local sec=$1 what=$2 owner=$3 count=$4 cpu=$5 age=$6 mem=${7:-0}
  [ "$owner" = "-" ] && owner=""
  local ci=${cpu%.*}
  # one glyph says what kind of problem this is before a word is read:
  # burning a core, a pile of clones, a memory hog, or just asleep in a corner
  local mark="$E_ZZZ"
  [ "$count" -gt 1 ] && mark="$E_CLONE"
  [ "${mem:-0}" -ge "$MEM_HOG_MB" ] && mark="$E_PIG"
  [ "${ci:-0}" -ge 20 ] && mark="$E_FIRE"
  local head="$what"
  [ "$count" -gt 1 ] && head="$what ${DIM}× ${count}${NC}"
  if [ -n "$owner" ]; then
    echo "  ${mark}${BLD}${head}${NC} ${DIM}— left by ${owner}${NC}"
  else
    echo "  ${mark}${BLD}${head}${NC}"
  fi
  if [ "${ci:-0}" -ge 20 ]; then
    echo "  Eating ${RED}${cpu}%${NC} of a CPU core. Running for $(plain_age "$age")."
  elif [ "${mem:-0}" -ge "$MEM_HOG_MB" ]; then
    # the amount is the whole point — "holding memory" undersells 7 GB
    if [ "$count" -gt 1 ]; then
      echo "  Together sitting on ${RED}$(mem_words "$mem")${NC} of memory. Oldest has sat there $(plain_age "$age")."
    else
      echo "  Sitting on ${RED}$(mem_words "$mem")${NC} of memory. Doing nothing for $(plain_age "$age")."
    fi
  elif [ "$count" -gt 1 ]; then
    echo "  Idle, but holding memory. Oldest has sat there $(plain_age "$age")."
  else
    echo "  Idle, but holding memory. Sitting there $(plain_age "$age")."
  fi
  local why; why=$(why_line "$sec")
  [ -n "$why" ] && echo "  ${DIM}${why}${NC}"
}

# Minimal JSON string escaping: backslash and double quote only. No control
# characters can reach here — every value is a pid, number, or process name.
jesc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# ---- helpers --------------------------------------------------------------
ppid_of()  { ps -o ppid= -p "$1" 2>/dev/null | tr -d ' '; }
comm_of()  { ps -o comm= -p "$1" 2>/dev/null; }
cpu_of()   { ps -o pcpu= -p "$1" 2>/dev/null | tr -d ' '; }
etime_of() { ps -o etime= -p "$1" 2>/dev/null | tr -d ' '; }
alive()    { kill -0 "$1" 2>/dev/null; }
short()    { sed 's|.*/||' | cut -c1-46; }

# A PID is reusable; PID + process start time is not. The app carries this
# opaque identity from scan to plan to action, and the engine compares it at
# each step. Never derive safety from a stale PID alone.
identity_of() {
  ps -o lstart= -o command= -p "$1" 2>/dev/null | cksum | awk '{print $1}'
}

targeted() {
  [ -z "$TARGETS" ] && return 0
  case " $TARGETS " in *" $1:$2 "*) return 0 ;; *) return 1 ;; esac
}

# macOS ps prints TIME as MMMM:SS.ss — minutes are NOT wrapped at 60
# ("6638:43.89" is 110 hours). Convert to whole seconds.
cpusecs() { echo "${1:-0:0}" | awk -F: '{printf "%d", $1*60 + $2}'; }
hms()     { awk -v s="$1" 'BEGIN{printf "%dh%02dm", s/3600, (s%3600)/60}'; }

# ---- process map -----------------------------------------------------------
# One `top` sample, taken once and parsed into
# "pid footprintMB compressedMB energyImpact cpuPercent" lines. top costs one
# to two SECONDS per invocation, so it must never appear inside a per-process
# loop the way the cheap ps lookups do — everything that needs a memory or
# power number reads this map instead, and there is exactly one top per run.
# top's MEM column is phys_footprint, the figure Activity Monitor shows; its
# CMPRS column is the slice macOS has compressed out because nothing touched
# it — the tell that a process is hoarding, not working. POWER is macOS's
# Energy Impact: a unitless composite that is a fine ranking signal and a
# terrible thing to show a person, so it never leaves this file as itself.
# Sorted biggest-memory-first here rather than by top, because the sort key
# has to stay the same whichever column this run cares about; the hog scan
# relies on that order to stop early. If top is missing or fails the map stays
# empty, footprint_of answers 0 for everyone, and every memory feature
# degrades to finding nothing rather than erroring.
#
# load_memmap [samples]. Energy asks for 2, and must: top's FIRST sample has
# no previous sample to diff against, so it reports POWER and %CPU as 0.0 for
# every process on the machine. Reading it gives a confidently empty answer,
# which is worse than an error. Only the last sample is ever parsed, so one
# sample and two samples come out of here the same shape.
MEMMAP=""
load_memmap() {
  MEMMAP=$(top -l "${1:-1}" -o power -n 2000 -stats pid,command,mem,cmprs,power,cpu 2>/dev/null | awk '
    # values arrive suffixed (7102M, 1.2G, 512K, 0B) — normalise to whole MB
    function mb(v) { sub(/[+-]$/, "", v)
      if (v ~ /G/) return int(v * 1024)
      if (v ~ /M/) return int(v + 0)
      if (v ~ /K/) return int(v / 1024)
      return 0 }
    # every sample restates the header, so a header means everything held so
    # far belonged to an earlier sample and is thrown away
    /^PID[ \t]+COMMAND/ { n = 0; next }
    $1 ~ /^[0-9]+$/ && NF >= 6 { n++
      row[n] = $1 " " mb($(NF-3)) " " mb($(NF-2)) " " $(NF-1)+0 " " $NF+0 }
    END { for (i = 1; i <= n; i++) print row[i] }' | sort -k2,2nr)
  # What fraction of ALL memory on this Mac is currently cold. Under real
  # pressure macOS compresses indiscriminately, so at 82% swap the innocent
  # apps sit at 83-93% cold too and an absolute "is it cold" test stops
  # separating anyone. The baseline is what makes cold mean something again:
  # what matters is being colder than everything else, not merely cold.
  SYS_COLD=$(printf '%s\n' "$MEMMAP" | awk '{t+=$2; c+=$3}
    END { p = (t > 0) ? int(c*100/t) : 0; print (p > 100) ? 100 : p }')
}
SYS_COLD=0
footprint_of()  { printf '%s\n' "$MEMMAP" | awk -v p="${1:-0}" '$1==p {print $2; f=1; exit} END{if (!f) print 0}'; }
compressed_of() { printf '%s\n' "$MEMMAP" | awk -v p="${1:-0}" '$1==p {print $3; f=1; exit} END{if (!f) print 0}'; }
# How much of the machine's compute is in use right now, in whole cores. The
# per-process %CPU column is used rather than top's "CPU usage:" summary line
# because power is handed out per process, and the two must add up against the
# same denominator or an app's share is measured against work nobody did.
busy_cores() { printf '%s\n' "$MEMMAP" | awk '{c += $5} END{printf "%.2f", c/100}'; }

# Host vitals, shared by the main scan's System section and `machogs memory`.
host_stats() {
  cores=$(sysctl -n hw.ncpu)
  # macOS: "load averages: 4.61 5.18 6.01" (space separated, no commas)
  load=$(uptime | sed 's/.*load averages*: *//' | awk '{print $1}' | tr -d ',')
  # macOS: "total = 16384.00M  used = 15131.31M  free = 1252.69M  (encrypted)"
  swap_tot=$(sysctl -n vm.swapusage  | awk '{print $3}' | tr -d 'M')
  swap_used=$(sysctl -n vm.swapusage | awk '{print $6}' | tr -d 'M')
  swap_pct=$(awk -v u="${swap_used:-0}" -v t="${swap_tot:-1}" 'BEGIN{printf "%d", (u/t)*100}')
}

# What the battery is actually doing, with no sudo anywhere: ioreg reads the
# smart battery directly (amperage in mA, negative while discharging; voltage
# in mV) and pmset supplies the charge and the estimate macOS itself shows.
# Sets: BATT_PRESENT, ON_BATTERY, CHARGING, CHARGE_PCT, TIME_LEFT, WATTS,
# WATTS_ESTIMATED.
#
# On battery the wattage is measured. Plugged in there is nothing to measure —
# the wall is paying — so it is modelled from how hard the machine is working,
# and WATTS_ESTIMATED says so out loud. Printing a measured-looking 0W, or the
# charger's draw, would both be lies about the same moment.
battery_stats() {
  local raw amp volt measured
  # anchored to the start of a line on purpose: the "BatteryData" blob is one
  # enormous line containing its own "Voltage"=... and would win otherwise
  raw=$(ioreg -rn AppleSmartBattery 2>/dev/null | awk -F' = ' \
    '/^ *"(Amperage|Voltage|IsCharging|ExternalConnected)" = / {
       k = $1; gsub(/[^A-Za-z]/, "", k); print k "=" $2 }')
  amp=$(printf '%s\n' "$raw"  | awk -F= '$1=="Amperage"{print $2}')
  volt=$(printf '%s\n' "$raw" | awk -F= '$1=="Voltage"{print $2}')
  BATT_PRESENT=false; [ -n "$volt" ] && BATT_PRESENT=true
  CHARGING=false;     printf '%s\n' "$raw" | grep -q 'IsCharging=Yes' && CHARGING=true
  ON_BATTERY=false
  if [ "$BATT_PRESENT" = true ] && ! printf '%s\n' "$raw" | grep -q 'ExternalConnected=Yes'; then
    ON_BATTERY=true
  fi
  CHARGE_PCT=$(pmset -g batt 2>/dev/null | grep -Eo '[0-9]+%' | head -1 | tr -d '%')
  CHARGE_PCT=${CHARGE_PCT:-0}
  # only meaningful while discharging: plugged in, this same field is time to
  # a FULL CHARGE, which is the opposite of what the word "left" would promise
  TIME_LEFT=""
  [ "$ON_BATTERY" = true ] && TIME_LEFT=$(pmset -g batt 2>/dev/null |
    sed -n 's/.*; \([0-9]*:[0-9]*\) remaining.*/\1/p' | head -1)
  BUSY_CORES=$(busy_cores)
  WATTS_ESTIMATED=true
  WATTS=$(awk -v idle="$WATTS_IDLE" -v per="$WATTS_PER_CORE" -v c="${BUSY_CORES:-0}" \
    'BEGIN{printf "%.1f", idle + per*c}')
  if [ "$ON_BATTERY" = true ] && [ -n "$amp" ]; then
    # Discharging current is milliamps and negative; times millivolts over a
    # million is watts. Some macOS builds report the same field as an unsigned
    # 64-bit value instead, so a discharge arrives as a number near 1.8e19 —
    # and awk's doubles cannot subtract that back down to milliamps without
    # losing more precision than the reading is worth. Anything that does not
    # come out as a wattage a laptop could plausibly be drawing is dropped in
    # favour of the model, which is at least honest about being one. A made-up
    # measured number is the only outcome worse than an estimate.
    measured=$(awk -v a="$amp" -v v="${volt:-0}" 'BEGIN{
      w = (a < 0 ? -a : a) * v / 1000000
      printf "%.1f", w }')
    if [ "$(awk -v w="$measured" 'BEGIN{print (w > 0.5 && w < 150) ? 1 : 0}')" = "1" ]; then
      WATTS=$measured
      WATTS_ESTIMATED=false
    fi
  fi
}
BATT_PRESENT=false; ON_BATTERY=false; CHARGING=false
CHARGE_PCT=0; TIME_LEFT=""; WATTS=0; WATTS_ESTIMATED=true; BUSY_CORES=0

# An APP is hoarding when it is big and either most of its memory has gone
# cold, or it has quietly piled up a crowd of processes. Cold is the honest
# tell: memory being USED stays resident, memory being SAT ON gets compressed
# away by macOS because nothing touches it — so a busy Xcode build (big but
# warm) does not trip this, while the incident app sat at 94% cold.
# Compressed can exceed footprint on virtual-machine processes (guest memory
# is accounted differently), which would print an impossible "177% cold".
# Clamp it: past 100 the message is the same.
cold_pct() { awk -v t="${1:-0}" -v c="${2:-0}" 'BEGIN{ p = (t > 0) ? int(c*100/t) : 0; print (p > 100) ? 100 : p }'; }

# hoarding <totalMB> <compressedMB> <processCount>
hoarding() {
  [ "${1:-0}" -ge "$MEM_APP_MB" ] || return 1
  local cold; cold=$(cold_pct "$1" "$2")
  # A crowd is damning only when the memory it holds is also going cold. Plenty
  # of honest tools run dozens of processes — an agent runner sat at 79 of them
  # while staying WARMER than the machine around it, because it was using them.
  # The incident app ran 100 and was colder than everything else on the Mac.
  [ "${3:-0}" -ge "$MEM_APP_PROCS" ] && [ "$cold" -ge "$SYS_COLD" ] && return 0
  [ "$cold" -ge "$MEM_COLD_PCT" ] || return 1
  # Clamp the bar: on a Mac already 90% cold, baseline+margin would ask for
  # more than 100% and quietly retire the cold test exactly when memory is
  # tightest. Past 95% there is no headroom left to be suspicious with.
  local bar=$(( SYS_COLD + MEM_COLD_MARGIN )); [ "$bar" -gt 95 ] && bar=95
  [ "$cold" -ge "$bar" ]
}

# Energy Impact -> minutes of battery an hour. The whole translation lives
# here, and it is a proportional split, not a measurement of the app:
#   share    = this app's impact / the impact of everything blameable
#   compute  = the watts the machine spends on running things, which is its
#              total draw less what it costs to merely be switched on
#   minutes  = 60 * share * (compute / total)
# The last step is what keeps it honest. Apps split the compute share of the
# drain between them; the screen, the radios and the idle machine keep the
# rest, so the app list never adds up to a whole hour of a battery it did not
# spend. An hour of running costs an hour of battery, and this says how many
# of those minutes each app took.
# drain_mins <appImpact> <totalImpact> <watts>
drain_mins() {
  awk -v ei="${1:-0}" -v tot="${2:-0}" -v w="${3:-0}" -v idle="$WATTS_IDLE" 'BEGIN{
    compute = w - idle; if (compute < 0) compute = 0
    if (tot <= 0 || w <= 0) { print "0.0"; exit }
    printf "%.1f", 60 * (ei/tot) * (compute/w) }'
}

# An app worth naming as a battery drainer is expensive AND has been expensive
# for as long as it has existed. Cost alone would name whatever you are using
# right now — a video call, a build, the editor you are typing in — which is
# true, useless, and reads as an accusation. Lifetime average CPU is the tell
# that separates them: an app you just gave work to has burned seconds against
# hours of being open, while the one to warn someone about has never stopped.
# draining <minutes> <cpuSeconds> <lifetimeSeconds>
draining() {
  awk -v m="${1:-0}" -v c="${2:-0}" -v e="${3:-0}" -v mins="$ENERGY_APP_MINS" \
      -v pct="$ENERGY_SUSTAIN_PCT" -v grace="$ENERGY_MIN_SECONDS" 'BEGIN{
    if (m < mins || e < grace) exit 1
    exit !((e > 0 ? c*100/e : 0) >= pct) }'
}

# Memory findings are shown, never reaped. A fat idle process is usually a
# leak and sometimes an editor holding work nobody saved, and a footprint
# cannot tell those apart — so this reports the evidence and leaves the
# decision with the person. Nothing here reaches KILL_LIST, so `machogs kill`
# cannot close one even if a caller names its pid, and FOUND stays untouched
# so the "N reapable" summary keeps meaning what it says.
queue_report() {
  local pid=$1 reason=$2 identity
  alive "$pid" || return
  identity=$(identity_of "$pid"); [ -n "$identity" ] || return
  targeted "$pid" "$identity" || return
  case " $QUEUED_PIDS " in *" $pid "*) return ;; esac
  QUEUED_PIDS="$QUEUED_PIDS $pid"
  printf "    %s%-7s%s mem=%-9s age=%-12s %s\n" \
    "$BLD" "$pid" "$NC" "$(mem_words "$(footprint_of "$pid")")" "$(etime_of "$pid")" "$reason"
  row "$pid" "$SECTION" "report-only" "$(cpu_of "$pid")" "$(etime_of "$pid")" "$reason"
}

# Walk up the process tree, printing every ancestor pid.
ancestry() {
  local cur=$1 hops=0
  while [ -n "$cur" ] && [ "$cur" != "0" ] && [ "$cur" != "1" ] && [ $hops -lt 12 ]; do
    echo "$cur"; cur=$(ppid_of "$cur"); hops=$((hops+1))
  done
}
root_of() { ancestry "$1" | tail -1; }

# Is this a real MCP server process, or a browser child that merely has "mcp"
# somewhere in its command line?
is_mcp() {
  local cmd; cmd=$(ps -o command= -p "$1" 2>/dev/null)
  [ -n "$cmd" ] || return 1
  # -e is required: NOT_MCP starts with "--", which grep would read as a flag
  echo "$cmd" | grep -qE -e "$NOT_MCP" && return 1
  echo "$cmd" | grep -qE -e "$MCP_PATTERNS"
}

# A stable signature for "the same server started twice": the script/binary it
# runs, ignoring paths and per-run flags.
sig_of() {
  ps -o command= -p "$1" 2>/dev/null | tr ' ' '\n' \
    | grep -vE '^-|^$' | sed -n '2p' | sed 's|.*/||'
}

# Rule 1: never touch our own ancestry.
SELF_SAFE=" $(ancestry $$ | tr '\n' ' ') "
# Rule 2: never touch Claude Code / the Claude app.
claude_app_pids() { pgrep -f "claude-code/.*MacOS/claude|Claude\.app/Contents/MacOS/Claude" 2>/dev/null; }
CLAUDE_SAFE=" $(claude_app_pids | tr '\n' ' ') "

protected() {
  local pid=$1 a
  # protected if the process itself, OR any of its ancestors, is our own
  # session or a live Claude Code session. This is the net that stops us
  # reaping the MCP servers belonging to sessions you're actively coding in.
  for a in $pid $(ancestry "$pid"); do
    case "$SELF_SAFE"   in *" $a "*) return 0 ;; esac
    case "$CLAUDE_SAFE" in *" $a "*) return 0 ;; esac
  done
  return 1
}

# ---- blame / brag ---------------------------------------------------------
# Reading the scoreboard. Both are read-only and touch no processes at all.
# The data is a fact only this tool can produce: which app leaks most on YOUR
# machine, measured, over months.

blame_table() {
  awk -F'\t' '
    $2=="closed" { app=$4; n[app]++; secs[app]+=$7; if ($7+0 > worst[app]+0) worst[app]=$7+0; next }
    # older free-text lines, two shapes:
    #   "... closed 123 — browser-control helper (ChatGPT)"
    #   "... killed 123 — duplicate server.cjs under ChatGPT"
    { if (match($0, /\(([^)]+)\)$/))      { app=substr($0, RSTART+1, RLENGTH-2); n[app]++ }
      else if (match($0, / under .+$/))   { app=substr($0, RSTART+7); n[app]++ }
      else n["unknown"]++ }
    END { for (a in n) printf "%d\t%d\t%d\t%s\n", n[a], secs[a], worst[a], a }
  ' "$LOG" 2>/dev/null | sort -rn
}

if [ "$MODE" = blame ] || [ "$MODE" = brag ]; then
  if [ ! -s "$LOG" ]; then
    echo "Nothing closed yet — no scoreboard to show."
    echo "${DIM}Run ${BLD}machogs fix${NC}${DIM} first.${NC}"
    exit 0
  fi
  total_n=0; total_s=0; worst_s=0; worst_app=""; first_seen=""
  first_seen=$(head -1 "$LOG" | cut -c1-10)
  BL=$(blame_table)

  if [ "$MODE" = blame ]; then
    echo
    echo "${BLD}Who leaves the most junk on your Mac${NC}"
    echo "${DIM}since ${first_seen}${NC}"
    echo
    printf "  %-26s %8s   %s\n" "APP" "CLOSED" "CPU TIME WASTED"
    crown="$E_CROWN"   # the table is sorted worst-first, so row one wears it
    while IFS=$'\t' read -r n secs worst app; do
      [ -n "$app" ] || continue
      printf "  %-26s %8s   %s%s\n" "$app" "$n" "$(burned "$secs")" "$crown"
      crown=""
    done < <(printf '%s\n' "$BL")
    echo
  fi

  while IFS=$'\t' read -r n secs worst app; do
    [ -n "$app" ] || continue
    total_n=$((total_n + n)); total_s=$((total_s + secs))
    if [ "${worst:-0}" -gt "$worst_s" ]; then worst_s=$worst; worst_app=$app; fi
  done < <(printf '%s\n' "$BL")

  if [ "$MODE" = brag ]; then
    top=$(printf '%s\n' "$BL" | head -1)
    top_app=$(printf '%s' "$top" | cut -f4); top_n=$(printf '%s' "$top" | cut -f1)
    charges=$(phone_charges "$total_s")
    echo
    echo "  ---------------------------------------------"
    # older log lines carry no CPU time; "0 seconds of work" is a terrible
    # brag, so below a minute the card leads with the body count instead
    if [ "${total_s:-0}" -ge 60 ]; then
      echo "   🐷 my mac was doing $(burned "$total_s") of work"
      echo "   for programs i never opened."
      echo
      echo "   $total_n background programs closed"
    else
      echo "   🐷 caught my mac running $total_n programs"
      echo "   i never opened. all closed."
    fi
    [ -n "$top_app" ] && echo "   worst offender: $top_app ($top_n of them)"
    [ "${worst_s:-0}" -gt 3600 ] && echo "   single worst: $(burned "$worst_s") burned by one process"
    [ "${charges:-0}" -ge 2 ] && echo "   wasted power ≈ $charges phone charges ⚡"
    echo
    echo "   caught in 4k by machogs"
    echo "   github.com/bnishit/machogs"
    echo "  ---------------------------------------------"
    echo
    echo "${DIM}Copy the block above. That is the post.${NC}"
    echo
  fi
  exit 0
fi

# ---- disk: where the storage went ------------------------------------------
# The storage X-ray. Same promise as the CPU side: find it, explain it in
# plain words, let the person decide. Reporting DELETES NOTHING, ever.
# `machogs disk clear <path>` is the one deliberate exception: it clears the
# CONTENTS of a directory, and only one this script itself listed as
# verdict=safe (rebuildable caches, the Trash). Any other path is refused.
if [ "$MODE" = disk ] || [ "$MODE" = clear-pending ]; then
  # On APFS the free space is shared across the container, so read the Data
  # volume: its "avail" is the real free space the person has left.
  set -- $(df -k /System/Volumes/Data 2>/dev/null | tail -1)
  blocks=${2:-0}; avail=${4:-0}
  if [ "${blocks:-0}" -eq 0 ]; then set -- $(df -k / | tail -1); blocks=${2:-0}; avail=${4:-0}; fi
  usedk=$((blocks - avail)); pct=$(( blocks > 0 ? usedk * 100 / blocks : 0 ))
  gbint() { awk -v k="${1:-0}" 'BEGIN{printf "%.0f", k/1048576}'; }
  gbone() { awk -v k="${1:-0}" 'BEGIN{ g=k/1048576; if (g>=10) printf "%.0f GB", g; else printf "%.1f GB", g }'; }

  # The usual suspects. label|icon|path|verdict|how
  # verdict: safe (clearing costs you nothing lasting), check (look first), yours (only you know)
  SUSPECTS="Trash|🗑️|$HOME/.Trash|safe|Finder → Empty Trash.
App caches|📦|$HOME/Library/Caches|safe|Apps rebuild these. First launches may be slower once.
Xcode build junk|🛠️|$HOME/Library/Developer/Xcode/DerivedData|safe|Xcode rebuilds it on the next build.
Old iPhone debug files|🛠️|$HOME/Library/Developer/Xcode/iOS DeviceSupport|check|Debug files per iPhone model. Old ones are dead weight.
iPhone backups|📱|$HOME/Library/Application Support/MobileSync/Backup|check|Finder → Manage Backups. Keep phones you still own.
Docker's disk image|🐳|$HOME/Library/Containers/com.docker.docker/Data|check|Docker Desktop: prune unused images, or shrink it in Settings.
iOS Simulators|🛠️|$HOME/Library/Developer/CoreSimulator|check|'xcrun simctl delete unavailable' clears dead simulators.
npm cache|📦|$HOME/.npm|safe|npm rebuilds it: npm cache clean --force
Downloads|⬇️|$HOME/Downloads|yours|You know what is in there."

  # `disk clear <path>` — the only deleting this script ever does. The path
  # must be one of the suspects above, verdict=safe, verbatim. Contents go,
  # the directory stays, and the freed size is measured, not guessed.
  if [ "$MODE" = clear-pending ]; then
    [ -n "$CLEAR_PATH" ] || { echo "Pick a path: machogs disk clear <path>" >&2; exit 2; }
    ok=0
    while IFS='|' read -r label icon path verdict how; do
      [ "$path" = "$CLEAR_PATH" ] && [ "$verdict" = safe ] && { ok=1; safelabel=$label; break; }
    done < <(printf '%s\n' "$SUSPECTS")
    if [ "$ok" -ne 1 ]; then
      echo "Refusing: $CLEAR_PATH is not on the safe-to-clear list." >&2
      echo "Safe paths are rebuildable caches and the Trash — run: machogs disk" >&2
      exit 3
    fi
    [ -e "$CLEAR_PATH" ] || { echo "Nothing there: $CLEAR_PATH" >&2; exit 3; }
    before=$(du -sk "$CLEAR_PATH" 2>/dev/null | cut -f1)
    find "$CLEAR_PATH" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null
    after=$(du -sk "$CLEAR_PATH" 2>/dev/null | cut -f1)
    freed_mb=$(( (${before:-0} - ${after:-0}) / 1024 )); [ "$freed_mb" -lt 0 ] && freed_mb=0
    printf '%s\tcleared\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$safelabel" "$CLEAR_PATH" "$freed_mb" >> "$LOG"
    if [ "$JSON" -eq 1 ]; then
      printf '{"mode": "clear", "path": "%s", "label": "%s", "freed_mb": %s}\n' \
        "$(jesc "$CLEAR_PATH")" "$(jesc "$safelabel")" "$freed_mb"
    else
      awk -v m="$freed_mb" 'BEGIN{ if (m>=1024) printf "🎉 Cleared %s — got back %.1f GB.\n", ARGV[1], m/1024; else printf "🎉 Cleared %s — got back %d MB.\n", ARGV[1], m }' "$safelabel"
    fi
    exit 0
  fi

  FOUND=$(printf '%s\n' "$SUSPECTS" | while IFS='|' read -r label icon path verdict how; do
    [ -e "$path" ] || continue
    sizek=$(du -sk "$path" 2>/dev/null | cut -f1)
    [ "${sizek:-0}" -ge 524288 ] || continue     # only worth saying at 0.5 GB+
    printf '%s|%s|%s|%s|%s|%s\n' "$sizek" "$label" "$icon" "$path" "$verdict" "$how"
  done | sort -t'|' -k1,1 -rn)

  if [ "$JSON" -eq 1 ]; then
    printf '{\n  "mode": "disk",\n'
    printf '  "disk": {"used_gb": %s, "total_gb": %s, "pct": %s},\n' "$(gbint $usedk)" "$(gbint $blocks)" "$pct"
    printf '  "items": [\n'
    first=1
    while IFS='|' read -r sizek label icon path verdict how; do
      [ -n "$sizek" ] || continue
      [ $first -eq 1 ] || printf ',\n'
      first=0
      printf '    {"label": "%s", "icon": "%s", "path": "%s", "size_mb": %s, "verdict": "%s", "how": "%s"}' \
        "$(jesc "$label")" "$icon" "$(jesc "$path")" "$((sizek / 1024))" "$verdict" "$(jesc "$how")"
    done < <(printf '%s\n' "$FOUND")
    [ $first -eq 0 ] && printf '\n'
    printf '  ]\n}\n'
    exit 0
  fi

  echo
  if [ "$pct" -ge 90 ]; then
    echo "💾 ${BLD}Your disk: $(gbint $usedk) GB used of $(gbint $blocks) GB (${pct}% full).${NC} ${RED}That's tight.${NC}"
  else
    echo "💾 ${BLD}Your disk: $(gbint $usedk) GB used of $(gbint $blocks) GB (${pct}% full).${NC}"
  fi
  echo
  if [ -z "$FOUND" ]; then
    echo "${GRN}Nothing chunky in the usual junk spots.${NC} Whatever is using your disk,"
    echo "it is your actual files — photos, videos, projects. No shortcuts there."
  else
    while IFS='|' read -r sizek label icon path verdict how; do
      [ -n "$sizek" ] || continue
      case "$verdict" in
        safe)  v="${GRN}Safe to clear:${NC}" ;;
        check) v="${YLW}Check first:${NC}" ;;
        *)     v="${DIM}Your call:${NC}" ;;
      esac
      echo "  ${icon} ${BLD}${label}${NC} — ${BLD}$(gbone $sizek)${NC}. ${v} ${how}"
    done < <(printf '%s\n' "$FOUND")
    echo
    echo "${DIM}machogs deletes nothing. It shows you where the weight is; you decide.${NC}"
  fi
  echo
  exit 0
fi

# ---- ports: who is squatting your ports ------------------------------------
# "Port 3000 is already in use" — the error that never says WHO. This does.
#   machogs ports            every listening port, in plain words
#   machogs port 3000        who holds 3000
#   machogs port 3000 kill   free it (same safety rules as everything else:
#                            never our own ancestry, never Claude Code, and
#                            macOS system daemons are named, not killed)
if [ "$PORTS" -eq 1 ]; then
  if [ "$MODE" = kill ] && [ -z "$PORT_NUM" ]; then
    echo "Pick a port: machogs port 3000 kill" >&2; exit 2
  fi

  # The famous squatters people google for hours.
  port_note() {
    case "$1" in
      ControlCenter) echo "macOS AirPlay Receiver squats ports 5000/7000. Turn off: System Settings → General → AirDrop & Handoff." ;;
      rapportd)      echo "macOS device-linking daemon. Harmless, leave it." ;;
      *) echo "" ;;
    esac
  }

  # Services are whack-a-mole: kill one and launchd respawns it in a second,
  # so offering a kill would be lying. Detect them and say how to stop them
  # for real instead. pid → launchd label via `launchctl list`; Homebrew
  # services also betray themselves by living in the Cellar.
  LAUNCHD_TBL=$(launchctl list 2>/dev/null | awk 'NR>1 && $1+0>0 {print $1 "\t" $3}')
  service_note() {
    local pid=$1 label path formula
    label=$(printf '%s\n' "$LAUNCHD_TBL" | awk -F'\t' -v p="$pid" '$1==p {print $2; exit}')
    if [ -n "$label" ]; then
      case "$label" in
        homebrew.mxcl.*)
          echo "a Homebrew service — killing it just respawns it. Stop it for real: brew services stop ${label#homebrew.mxcl.}" ;;
        *)
          echo "a background service ($label) — killing it just respawns it. Stop: launchctl bootout gui/$(id -u)/$label" ;;
      esac
      return
    fi
    path=$(ps -o comm= -p "$pid" 2>/dev/null)
    case "$path" in
      */Cellar/*)
        formula=$(printf '%s' "$path" | sed 's|.*/Cellar/||; s|/.*||')
        echo "part of Homebrew's $formula service — it tends to come back if killed. Try: brew services stop $formula" ;;
    esac
  }

  # lsof -F: p=pid, c=command, n=name — survives commands with spaces.
  TBLP=$(lsof -nP -iTCP -sTCP:LISTEN -Fpcn 2>/dev/null | awk '
    /^p/ { pid=substr($0,2) }
    /^c/ { cmd=substr($0,2) }
    /^n/ { k=split($0, a, ":"); port=a[k];
           if (port+0 > 0) print port "\t" pid "\t" cmd }
  ' | sort -t"$TAB" -k1,1n -k2,2n -u)
  [ -n "$PORT_NUM" ] && TBLP=$(printf '%s\n' "$TBLP" | awk -F'\t' -v p="$PORT_NUM" '$1==p+0')

  ME_UID=$(id -u)
  if [ "$JSON" -eq 1 ]; then
    printf '{\n  "mode": "ports",\n  "ports": [\n'
    first=1
  fi
  if [ "$JSON" -eq 0 ]; then
    echo
    if [ -n "$PORT_NUM" ] && [ -z "$TBLP" ]; then
      echo "🔌 ${GRN}Port $PORT_NUM is free.${NC} Nothing is listening on it."
      echo; exit 0
    fi
    [ -z "$PORT_NUM" ] && echo "🔌 ${BLD}Ports in use on your Mac${NC}" && echo
    [ -z "$TBLP" ] && echo "  ${GRN}none${NC} — nothing is listening."
  fi

  FREED=0
  while IFS=$TAB read -r port pid cmd; do
    [ -n "$port" ] || continue
    alive "$pid" || continue
    uid=$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')
    age=$(plain_age "$(etime_of "$pid")")
    cwd=$(lsof -p "$pid" -a -d cwd 2>/dev/null | tail -1 | awk '{print $NF}' | sed "s|^$HOME|~|")
    o=$(whose "$pid"); note=$(port_note "$cmd")
    [ -z "$note" ] && note=$(service_note "$pid")
    sys=0; [ "$uid" != "$ME_UID" ] && sys=1
    prot=0; protected "$pid" && prot=1
    identity=$(identity_of "$pid")
    action="report"

    if [ "$MODE" = kill ] && [ -n "$PORT_NUM" ]; then
      if ! targeted "$pid" "$identity"; then
        action="identity-changed"
      elif [ $sys -eq 1 ] || [ -n "$note" ]; then
        action="refused-system"
      elif [ $prot -eq 1 ]; then
        action="refused-protected"
      else
        w=$(whatis "$pid"); cpu=$(cpu_of "$pid"); csec=$(cputime_of "$pid")
        # Re-check both gates at the last possible moment.
        if protected "$pid"; then
          action="refused-protected"
        elif [ "$(identity_of "$pid")" != "$identity" ]; then
          action="identity-changed"
        elif kill -9 "$pid" 2>/dev/null; then
          logclose "$pid" "$o" "$w" "$cpu" "$csec"
          FREED=$((FREED+1)); action="killed"
        else
          action="failed"
        fi
      fi
    fi

    if [ "$JSON" -eq 1 ]; then
      [ $first -eq 1 ] || printf ',\n'
      first=0
      printf '    {"port": %s, "pid": %s, "identity": "%s", "process": "%s", "owner": "%s", "cwd": "%s", "age": "%s", "system": %s, "protected": %s, "note": "%s", "action": "%s"}' \
        "$port" "$pid" "$(jesc "$identity")" "$(jesc "$cmd")" "$(jesc "$o")" "$(jesc "$cwd")" "$(jesc "$age")" \
        "$([ $sys -eq 1 ] && echo true || echo false)" "$([ $prot -eq 1 ] && echo true || echo false)" "$(jesc "$note")" "$(jesc "$action")"
      continue
    fi

    # who-is-it, in one line
    desc="$cmd"
    [ -n "$o" ] && desc="$cmd ${DIM}(started by $o)${NC}"
    line="  ${BLD}:$port${NC}  $desc"
    [ -n "$cwd" ] && [ "$cwd" != "/" ] && line="$line ${DIM}in $cwd${NC}"
    line="$line ${DIM}— running $age${NC}"
    if [ $sys -eq 1 ]; then line="$line  ${YLW}[system]${NC}"
    elif [ $prot -eq 1 ]; then line="$line  ${GRN}[your live session]${NC}"; fi
    echo "$line"
    [ -n "$note" ] && echo "         ${DIM}$note${NC}"

    if [ "$MODE" = kill ] && [ -n "$PORT_NUM" ]; then
      case "$action" in
      refused-system)
        echo "         ${YLW}That is a macOS system process — not killable from here.${NC}"
        ;;
      refused-protected)
        echo "         ${YLW}That belongs to a live Claude Code session. Quit it there instead.${NC}"
        ;;
      identity-changed) echo "         ${YLW}The listener changed after review. Nothing was closed.${NC}" ;;
      killed) echo "         ${GRN}Closed it. Port $PORT_NUM is free.${NC}" ;;
      failed) echo "         ${RED}Couldn't close pid $pid.${NC}" ;;
      esac
    fi
  done < <(printf '%s\n' "$TBLP")

  if [ "$JSON" -eq 1 ]; then
    [ $first -eq 0 ] && printf '\n'
    printf '  ]\n}\n'
  else
    echo
    if [ -n "$PORT_NUM" ] && [ "$MODE" != kill ] && [ -n "$TBLP" ]; then
      echo "${DIM}Free it:  ${NC}${BLD}machogs port $PORT_NUM kill${NC}"
      echo
    fi
  fi
  exit 0
fi

# ---- memory: which apps hold your memory ------------------------------------
# The Force Quit dialog answers "what is taking my memory" with one number per
# APP. Nothing per-process can: the real incident was 24 GB across 100
# processes under one chat app, with no single process near the total — every
# per-process view told a smaller story than the true headline. So this mode
# rolls every process up to the app responsible for it and ranks the apps.
# A running app is NOT assumed healthy here (that assumption is exactly what
# section 4 codifies, and exactly what let the incident grow for 65 hours).
# Report only, like disk: this mode kills nothing, ever.
if [ "$MEMORY" -eq 1 ]; then
  host_stats
  load_memmap

  # One ps snapshot of the user's processes. Rolling up with root_of would
  # fork ps a dozen times per process — a few hundred processes is seconds of
  # forking for answers this one table already holds, so the same ancestry
  # walk runs against the snapshot instead.
  PIDTBL=$(ps -U "$(id -un)" -o pid=,ppid=,etime=,ucomm= | MM="$MEMMAP" awk '
    function esecs(e,  d, t, x, a, n) { d = 0; t = e
      if (e ~ /-/) { split(e, x, "-"); d = x[1]; t = x[2] }
      n = split(t, a, ":")
      return d*86400 + (n == 3 ? a[1]*3600 + a[2]*60 + a[3] : a[1]*60 + a[2]) }
    BEGIN { n = split(ENVIRON["MM"], L, "\n")
      for (i = 1; i <= n; i++) { split(L[i], f, " "); mem[f[1]] = f[2]; cmp[f[1]] = f[3] } }
    { pid = $1; pp[pid] = $2; et[pid] = $3
      name = $4; for (i = 5; i <= NF; i++) name = name " " $i
      nm[pid] = name; order[++cnt] = pid }
    END {
      for (i = 1; i <= cnt; i++) {
        pid = order[i]; r = pid; hops = 0
        while (pp[r] in nm && pp[r] != r && hops < 12) { r = pp[r]; hops++ }
        printf "%s\t%s\t%d\t%d\t%d\t%s\t%s\n", r, pid, mem[pid]+0, cmp[pid]+0, esecs(et[pid]), et[pid], nm[pid]
      }
    }')

  # Name only the roots whose subtree could matter; whose() costs an lsof per
  # call, and most roots are tiny one-process daemons nobody needs ranked.
  NAMES=""
  for r in $(printf '%s\n' "$PIDTBL" | awk -F'\t' -v crowd="$MEM_APP_PROCS" \
      '{ tot[$1] += $3; n[$1]++ } END { for (r in tot) if (tot[r] >= 64 || n[r] >= crowd) print r }'); do
    o=$(whose "$r"); [ -n "$o" ] || o=$(comm_of "$r" | short); [ -n "$o" ] || o="pid $r"
    NAMES="${NAMES}${r}${TAB}${o}
"
  done

  # Two roots can answer to the same app (an orphaned helper re-parented to
  # launchd still belongs to the app that left it), so the rollup groups by
  # NAME, not by root pid — same as the Force Quit dialog would.
  APPTBL=$(printf '%s\n' "$PIDTBL" | NM="$NAMES" awk -F'\t' '
    BEGIN { n = split(ENVIRON["NM"], L, "\n")
      for (i = 1; i <= n; i++) { k = index(L[i], "\t"); if (k) app[substr(L[i], 1, k-1)] = substr(L[i], k+1) } }
    $1 in app {
      a = app[$1]
      tot[a] += $3; cm[a] += $4; cnt[a]++
      if ($5 >= old[a]) { old[a] = $5; oldage[a] = $6 }
      if ($3 >= bigm[a]) { bigm[a] = $3; bigp[a] = $2; bign[a] = $7 }
    }
    END { for (a in tot) printf "%d\t%d\t%d\t%s\t%s\t%d\t%s\t%s\n",
            tot[a], cm[a], cnt[a], oldage[a], bigp[a], bigm[a], bign[a], a }
  ' | sort -t"$TAB" -k1,1nr)
  PROCTBL=$(printf '%s\n' "$PIDTBL" | NM="$NAMES" awk -F'\t' '
    BEGIN { n = split(ENVIRON["NM"], L, "\n")
      for (i = 1; i <= n; i++) { k = index(L[i], "\t"); if (k) app[substr(L[i], 1, k-1)] = substr(L[i], k+1) } }
    ($1 in app) && $3 >= 16 { printf "%s\t%s\t%s\t%s\t%s\t%s\n", app[$1], $2, $3, $4, $6, $7 }
  ' | sort -t"$TAB" -k1,1 -k3,3nr)

  if [ "$JSON" -eq 1 ]; then
    printf '{\n  "mode": "memory",\n'
    printf '  "host": {"load": %s, "cores": %s, "swap_used_mb": %s, "swap_total_mb": %s, "swap_pct": %s, "uptime_days": %s},\n' \
      "${load:-0}" "${cores:-0}" "${swap_used:-0}" "${swap_tot:-0}" "${swap_pct:-0}" \
      "$(uptime | sed -n 's/.*up \([0-9]*\) day.*/\1/p' | head -1 | grep -E '^[0-9]+$' || echo 0)"
    printf '  "apps": [\n'
    first=1
    while IFS=$TAB read -r tot cm cnt oldage bigp bigm bign appname; do
      [ -n "$appname" ] || continue
      hoard=false; hoarding "$tot" "$cm" "$cnt" && hoard=true
      [ $first -eq 1 ] || printf ',\n'
      first=0
      printf '    {"app": "%s", "memory_mb": %s, "compressed_mb": %s, "cold_pct": %s, "processes": %s, "oldest_age": "%s", "hoarding": %s, "procs": [' \
        "$(jesc "$appname")" "$tot" "$cm" "$(cold_pct "$tot" "$cm")" "$cnt" \
        "$(jesc "$(plain_age "$oldage")")" "$hoard"
      pfirst=1
      while IFS=$TAB read -r _a ppid pmem pcmp petime pname; do
        [ -n "$ppid" ] || continue
        [ $pfirst -eq 1 ] || printf ', '
        pfirst=0
        printf '{"pid": %s, "name": "%s", "memory_mb": %s, "compressed_mb": %s, "age": "%s"}' \
          "$ppid" "$(jesc "$pname")" "$pmem" "$pcmp" "$(jesc "$(plain_age "$petime")")"
      done < <(printf '%s\n' "$PROCTBL" | awk -F'\t' -v a="$appname" '$1 == a' | head -12)
      printf ']}'
    done < <(printf '%s\n' "$APPTBL")
    [ $first -eq 0 ] && printf '\n'
    printf '  ]\n}\n'
    exit 0
  fi

  echo
  echo "🧠 ${BLD}Your memory, by app${NC}  ${DIM}everything each app's processes hold, added up${NC}"
  if [ "$swap_pct" -gt 80 ]; then
    echo "   ${RED}Your Mac is ${swap_pct}% into its slow backup memory${NC} — this list is why it feels slow."
    echo "   ${DIM}Apps here average ${SYS_COLD}% cold. Anything colder than that is hoarding, not working.${NC}"
  fi
  echo
  [ -z "$APPTBL" ] && echo "  ${DIM}Could not read memory sizes (is \`top\` unavailable?).${NC}"
  while IFS=$TAB read -r tot cm cnt oldage bigp bigm bign appname; do
    [ -n "$appname" ] || continue
    cold=$(cold_pct "$tot" "$cm")
    line="  $(printf '%-24s' "$appname") ${BLD}$(printf '%9s' "$(mem_words "$tot")")${NC}  ${DIM}$(printf '%3s' "$cold")% cold · $(count_unit "$cnt" process) · oldest $(plain_age "$oldage")${NC}"
    if hoarding "$tot" "$cm" "$cnt"; then
      echo "$line  ${RED}← hoarding${NC}"
      echo "      ${DIM}biggest piece: $bign (pid $bigp) holding $(mem_words "$bigm")${NC}"
    else
      echo "$line"
    fi
  done < <(printf '%s\n' "$APPTBL")
  echo
  echo "${DIM}Cold memory has been pushed out to disk because nothing has touched it in a long${NC}"
  echo "${DIM}time. An app doing real work stays warm. This report closes nothing — to get the${NC}"
  echo "${DIM}memory back, quit the app itself.${NC}"
  echo
  exit 0
fi

# ---- energy: where the battery is going -------------------------------------
# macOS already knows the answer and states it as "Energy Impact: 32.4", which
# is a unitless composite and tells a person nothing they can act on. So the
# impact number is used here only to rank and to split, and never printed. The
# printed answer is the one a person feels: how many minutes of their battery
# an app costs them per hour it runs.
# Report only, like memory, and for a sharper reason: the app burning your
# battery is very often the one you are looking at. Closing it is not this
# tool's call.
if [ "$ENERGY" -eq 1 ]; then
  load_memmap 2
  battery_stats

  # Every process on the machine, not only this user's, unlike the memory
  # rollup: a system daemon reindexing the disk drains the same battery a
  # browser does, and that is frequently the true answer to "why is it dying
  # today". The ancestry walk stops short of pid 1 for the same reason
  # ancestry() does — launchd is everyone's parent, and rolling up into it
  # would report the whole Mac as one app called launchd.
  PIDTBL=$(ps -ax -o pid=,ppid=,etime=,time=,ucomm= | MM="$MEMMAP" NB="$NEVER_BLAME" awk '
    function esecs(e,  d, t, x, a, n) { d = 0; t = e
      if (e ~ /-/) { split(e, x, "-"); d = x[1]; t = x[2] }
      n = split(t, a, ":")
      return d*86400 + (n == 3 ? a[1]*3600 + a[2]*60 + a[3] : a[1]*60 + a[2]) }
    # macOS ps prints TIME as MMMM:SS.ss and does NOT wrap minutes at 60
    function csecs(t,  a) { split(t, a, ":"); return a[1]*60 + a[2] }
    BEGIN { n = split(ENVIRON["MM"], L, "\n")
      for (i = 1; i <= n; i++) { split(L[i], f, " "); pw[f[1]] = f[4] } }
    { pid = $1; pp[pid] = $2; et[pid] = $3; tm[pid] = $4
      name = $5; for (i = 6; i <= NF; i++) name = name " " $i
      nm[pid] = name; order[++cnt] = pid }
    END {
      for (i = 1; i <= cnt; i++) {
        pid = order[i]
        if (nm[pid] ~ ENVIRON["NB"]) continue
        r = pid; hops = 0
        while ((pp[r] in nm) && pp[r] != r && pp[r] > 1 && hops < 12) { r = pp[r]; hops++ }
        printf "%s\t%s\t%.1f\t%d\t%d\t%s\t%s\n",
          r, pid, pw[pid]+0, csecs(tm[pid]), esecs(et[pid]), et[pid], nm[pid]
      }
    }')

  # The impact of everything that can be blamed, which is what each app's
  # share is measured against. Summed over every process, not only the ones
  # big enough to be named below, so a long tail of small daemons is counted
  # against the apps rather than quietly inflating them.
  TOTAL_EI=$(printf '%s\n' "$PIDTBL" | awk -F'\t' '{t += $3} END{printf "%.1f", t+0}')

  # Name only roots whose subtree could matter; whose() costs an lsof per call.
  NAMES=""
  for r in $(printf '%s\n' "$PIDTBL" | awk -F'\t' '{ tot[$1] += $3 } END { for (r in tot) if (tot[r] >= 1) print r }'); do
    o=$(whose "$r"); [ -n "$o" ] || o=$(comm_of "$r" | short); [ -n "$o" ] || o="pid $r"
    NAMES="${NAMES}${r}${TAB}${o}
"
  done

  # Grouped by NAME rather than root pid, same as the memory rollup: two roots
  # can answer to one app once a helper has been re-parented.
  APPTBL=$(printf '%s\n' "$PIDTBL" | NM="$NAMES" awk -F'\t' '
    BEGIN { n = split(ENVIRON["NM"], L, "\n")
      for (i = 1; i <= n; i++) { k = index(L[i], "\t"); if (k) app[substr(L[i], 1, k-1)] = substr(L[i], k+1) } }
    $1 in app {
      a = app[$1]
      ei[a] += $3; cs[a] += $4; cnt[a]++
      if ($5 >= old[a]) { old[a] = $5; oldage[a] = $6 }
      if ($3 >= bigei[a]) { bigei[a] = $3; bigp[a] = $2; bign[a] = $7 }
    }
    END { for (a in ei) printf "%.1f\t%d\t%d\t%d\t%s\t%s\t%.1f\t%s\t%s\n",
            ei[a], cnt[a], cs[a], old[a], oldage[a], bigp[a], bigei[a], bign[a], a }
  ' | sort -t"$TAB" -k1,1nr)
  PROCTBL=$(printf '%s\n' "$PIDTBL" | NM="$NAMES" awk -F'\t' '
    BEGIN { n = split(ENVIRON["NM"], L, "\n")
      for (i = 1; i <= n; i++) { k = index(L[i], "\t"); if (k) app[substr(L[i], 1, k-1)] = substr(L[i], k+1) } }
    ($1 in app) && $3 > 0 { printf "%s\t%s\t%s\t%s\t%s\n", app[$1], $2, $3, $6, $7 }
  ' | sort -t"$TAB" -k1,1 -k3,3nr)

  if [ "$JSON" -eq 1 ]; then
    printf '{\n  "mode": "energy",\n'
    printf '  "power": {"battery_present": %s, "on_battery": %s, "charging": %s, "charge_pct": %s, "time_left": "%s", "watts": %s, "watts_estimated": %s, "busy_cores": %s},\n' \
      "$BATT_PRESENT" "$ON_BATTERY" "$CHARGING" "${CHARGE_PCT:-0}" \
      "$(jesc "$(time_left_words "$TIME_LEFT")")" "${WATTS:-0}" "$WATTS_ESTIMATED" "${BUSY_CORES:-0}"
    printf '  "apps": [\n'
    first=1
    while IFS=$TAB read -r ei cnt csec oldsec oldage bigp bigei bign appname; do
      [ -n "$appname" ] || continue
      mins=$(drain_mins "$ei" "$TOTAL_EI" "$WATTS")
      drain=false; draining "$mins" "$csec" "$oldsec" && drain=true
      [ $first -eq 1 ] || printf ',\n'
      first=0
      printf '    {"app": "%s", "minutes_per_hour": %s, "share_pct": %s, "processes": %s, "cpu_seconds": %s, "lifetime_seconds": %s, "oldest_age": "%s", "draining": %s, "procs": [' \
        "$(jesc "$appname")" "$mins" \
        "$(awk -v e="$ei" -v t="${TOTAL_EI:-0}" 'BEGIN{printf "%d", (t > 0) ? e*100/t : 0}')" \
        "$cnt" "$csec" "$oldsec" "$(jesc "$(plain_age "$oldage")")" "$drain"
      pfirst=1
      while IFS=$TAB read -r _a ppid pei petime pname; do
        [ -n "$ppid" ] || continue
        [ $pfirst -eq 1 ] || printf ', '
        pfirst=0
        printf '{"pid": %s, "name": "%s", "minutes_per_hour": %s, "age": "%s"}' \
          "$ppid" "$(jesc "$pname")" "$(drain_mins "$pei" "$TOTAL_EI" "$WATTS")" \
          "$(jesc "$(plain_age "$petime")")"
      done < <(printf '%s\n' "$PROCTBL" | awk -F'\t' -v a="$appname" '$1 == a' | head -8)
      printf ']}'
    done < <(printf '%s\n' "$APPTBL")
    [ $first -eq 0 ] && printf '\n'
    printf '  ]\n}\n'
    exit 0
  fi

  echo
  echo "🔋 ${BLD}Where your battery is going${NC}  ${DIM}every app's background pieces added up${NC}"
  echo
  # Watts are the one physical unit here a person has actually met — it is
  # printed on their charger. Everything else is minutes.
  watts_words=$(awk -v w="${WATTS:-0}" 'BEGIN{printf "%d", w + 0.5}')
  if [ "$BATT_PRESENT" != true ]; then
    echo "  This Mac runs off the wall, so nothing is draining. What follows is what"
    echo "  each app would cost you on a laptop battery."
  elif [ "$ON_BATTERY" = true ]; then
    left=$(time_left_words "$TIME_LEFT")
    echo "  On battery, ${BLD}${CHARGE_PCT}% left${NC}${left:+, $left to go}."
    echo "  Your Mac is pulling about ${watts_words} watts right now."
  else
    charge=""; [ "$CHARGING" = true ] && charge=" and charging"
    echo "  Plugged in${charge}, ${BLD}${CHARGE_PCT}%${NC}. Nothing is draining right now — what follows"
    echo "  is what each app would cost you the moment you unplug."
    echo "  Working this hard, your Mac would be pulling about ${watts_words} watts."
  fi

  # The headline. One sentence, naming one app, is the whole answer for most
  # people; the table underneath is for the ones who want to see the working.
  top_app=$(printf '%s\n' "$APPTBL" | head -1 | cut -f9)
  top_ei=$(printf '%s\n' "$APPTBL" | head -1 | cut -f1)
  top_mins=$(drain_mins "${top_ei:-0}" "$TOTAL_EI" "$WATTS")
  if [ -n "$top_app" ] && [ "$(awk -v m="$top_mins" 'BEGIN{print (m >= 1) ? 1 : 0}')" = "1" ]; then
    echo
    echo "  ${BLD}${top_app} is the biggest drain on your Mac right now.${NC}"
    if [ "$ON_BATTERY" = true ]; then
      echo "  It is costing you $(mins_words "$top_mins") of battery every hour."
    else
      echo "  Unplugged, it would cost you $(mins_words "$top_mins") of battery every hour."
    fi
  fi
  echo
  [ -z "$APPTBL" ] && echo "  ${DIM}Could not read power use (is \`top\` unavailable?).${NC}"
  # Anything under a minute an hour is not an answer to anybody's question, so
  # the tail is added up in one line rather than listed. The table is sorted by
  # cost, so the first app below the bar is where the list ends.
  shown_ei=0; shown=0
  while IFS=$TAB read -r ei cnt csec oldsec oldage bigp bigei bign appname; do
    [ -n "$appname" ] || continue
    mins=$(drain_mins "$ei" "$TOTAL_EI" "$WATTS")
    [ "$(awk -v m="$mins" 'BEGIN{print (m >= 1) ? 1 : 0}')" = "1" ] || break
    [ "$shown" -ge 10 ] && break
    shown=$((shown+1))
    shown_ei=$(awk -v a="$shown_ei" -v b="$ei" 'BEGIN{printf "%.1f", a+b}')
    line="  $(printf '%-24s' "$appname") ${BLD}$(printf '%-25s' "$(drain_words "$mins")")${NC} ${DIM}$(count_unit "$cnt" process)${NC}"
    if draining "$mins" "$csec" "$oldsec"; then
      echo "$line  ${RED}← draining you${NC}"
      echo "      ${DIM}hardest worker: $bign (pid $bigp), $(drain_words "$(drain_mins "$bigei" "$TOTAL_EI" "$WATTS")") on its own${NC}"
    else
      echo "$line"
    fi
  done < <(printf '%s\n' "$APPTBL")
  [ -n "$APPTBL" ] && [ "$shown" -eq 0 ] &&
    echo "  ${GRN}Nothing is using enough power to be worth naming.${NC}"
  rest=$(drain_mins "$(awk -v t="${TOTAL_EI:-0}" -v s="${shown_ei:-0}" 'BEGIN{printf "%.1f", (t>s) ? t-s : 0}')" "$TOTAL_EI" "$WATTS")
  [ "$(awk -v m="$rest" 'BEGIN{print (m >= 1) ? 1 : 0}')" = "1" ] &&
    echo "  $(printf '%-24s' "Everything else") ${DIM}$(drain_words "$rest"), spread thin${NC}"
  echo
  echo "${DIM}These are estimates. Machogs takes what your Mac is drawing right now and${NC}"
  echo "${DIM}splits it between apps by how hard each one is working, so treat them as${NC}"
  echo "${DIM}a ranking you can trust and a number you should not quote to the minute.${NC}"
  echo "${DIM}Your screen and the machine itself take the rest. This report closes${NC}"
  echo "${DIM}nothing — quitting the app is what gets the battery back.${NC}"
  echo
  exit 0
fi

# --check: prove the safety net works. Lists every automation process and
# whether the script would refuse to kill it, and why. Kills nothing.
if [ "$MODE" = check ]; then
  echo "${BLD}=== machogs --check ===${NC}  ${DIM}safety audit, kills nothing${NC}"
  echo "  own ancestry protected : $(echo $SELF_SAFE | wc -w | tr -d ' ') pids"
  echo "  Claude Code protected  : $(echo $CLAUDE_SAFE | wc -w | tr -d ' ') pids"
  echo
  printf "  %-8s %-11s %-18s %s\n" PID VERDICT OWNER COMMAND
  for pid in $(pgrep -f "$MCP_PATTERNS" 2>/dev/null); do
    alive "$pid" || continue
    is_mcp "$pid" || continue
    owner=$(comm_of "$(root_of "$pid")" | short)
    if protected "$pid"; then v="${GRN}PROTECTED${NC}"; else v="${YLW}reapable${NC} "; fi
    printf "  %-8s %-22b %-18s %s\n" "$pid" "$v" "${owner:-?}" "$(sig_of "$pid")"
  done
  echo
  echo "  ${DIM}Anything owned by Claude Code must read PROTECTED.${NC}"
  exit 0
fi

# --check is a human audit and prints its own report, so the redirect goes in
# below it. In --json and plain-language modes the technical report still runs
# — it is simply sent to /dev/null, so the output paths can never drift apart.
# Real stdout is parked on fd 4 and restored at the end.
if [ "$JSON" -eq 1 ] || [ "$HUMAN" -eq 1 ]; then exec 4>&1 1>/dev/null; fi

KILLED=0; FOUND=0; KILLED_PIDS=""; FREED_CPU=0; FREED_CSEC=0
declare -a KILL_LIST=()
QUEUED_PIDS=""

# queue <pid> <reason>
queue() {
  local pid=$1 reason=$2 identity
  alive "$pid" || return
  identity=$(identity_of "$pid"); [ -n "$identity" ] || return
  # A targeted app request is deliberately narrow. A reused or already-gone
  # process does not match, is not shown in the fresh plan, and cannot be
  # replaced by a different current finding.
  targeted "$pid" "$identity" || return
  # One pid, one finding. A process can match two sections (an orphaned MCP
  # server that is also spinning); the first section to claim it wins, or the
  # report shows the same process twice and fix/kill act on it twice.
  case " $QUEUED_PIDS " in *" $pid "*) return ;; esac
  QUEUED_PIDS="$QUEUED_PIDS $pid"
  if protected "$pid"; then
    printf "    %sskip%s %-7s %s ${DIM}(protected: own session / Claude Code)${NC}\n" "$DIM" "$NC" "$pid" "$reason"
    row "$pid" "$SECTION" "protected" "$(cpu_of $pid)" "$(etime_of $pid)" "$reason"
    return
  fi
  FOUND=$((FOUND+1))
  KILL_LIST+=("$pid|$identity|$reason")
  printf "    %s%-7s%s cpu=%-5s age=%-12s %s\n" "$BLD" "$pid" "$NC" "$(cpu_of $pid)%" "$(etime_of $pid)" "$reason"
  row "$pid" "$SECTION" "reapable" "$(cpu_of $pid)" "$(etime_of $pid)" "$reason"
}

flush_kills() {
  [ "$MODE" = kill ] || return
  [ ${#KILL_LIST[@]} -eq 0 ] && return
  echo
  echo "  ${YLW}killing ${#KILL_LIST[@]} process(es)...${NC}"
  local entry pid identity reason
  for entry in "${KILL_LIST[@]}"; do
    pid=${entry%%|*}; entry=${entry#*|}; identity=${entry%%|*}; reason=${entry#*|}
    alive "$pid" || continue
    # Protection is time-sensitive. Check again at the last possible moment,
    # not only when the detector first queued the process.
    if protected "$pid"; then
      echo "    ${DIM}skip${NC} $pid ${DIM}(became protected before close)${NC}"
      continue
    fi
    if [ "$(identity_of "$pid")" != "$identity" ]; then
      echo "    ${DIM}skip${NC} $pid ${DIM}(process identity changed before close)${NC}"
      continue
    fi
    # read the identity BEFORE killing; afterwards ps knows nothing about it
    local who what cpu csec
    who=$(whose "$pid"); what=$(whatis "$pid")
    cpu=$(cpu_of "$pid"); csec=$(cputime_of "$pid")
    if kill -9 "$pid" 2>/dev/null; then
      KILLED=$((KILLED+1))
      KILLED_PIDS="$KILLED_PIDS $pid"
      FREED_CPU=$(awk -v a="$FREED_CPU" -v b="${cpu:-0}" 'BEGIN{printf "%.1f", a+b}')
      FREED_CSEC=$((FREED_CSEC + csec))
      logclose "$pid" "$who" "$what" "$cpu" "$csec"
      echo "    ${RED}killed${NC} $pid ${DIM}($reason)${NC}"
    fi
  done
  KILL_LIST=()
}

# Printing a section header is also what sets the section id used by row(), so
# the two can never disagree about which bucket a finding landed in. "1b. Stuck
# spinners ..." -> SECTION=1b.
SECTION="0"
hdr() {
  SECTION=$(printf '%s' "$1" | sed 's/\..*//')
  echo; echo "${BLU}${BLD}$1${NC}"
}

# ---- 0. system health -----------------------------------------------------
host_stats
# The one top sample every memory check below reads from. Taken here, before
# any section runs, because top costs a second or two and must never be paid
# more than once per scan.
load_memmap

echo "${BLD}=== machogs ===${NC}  ${DIM}$(date '+%F %H:%M')  ·  mode: $MODE${NC}"
hdr "System"
loadint=${load%.*}
if [ "${loadint:-0}" -gt "$cores" ]; then
  echo "  load ${RED}$load${NC} on $cores cores  ${RED}<- oversubscribed${NC}"
else
  echo "  load ${GRN}$load${NC} on $cores cores"
fi
if [ "$swap_pct" -gt 80 ]; then
  echo "  swap ${RED}${swap_used}M / ${swap_tot}M (${swap_pct}%)${NC}  ${RED}<- thrashing, reboot to clear${NC}"
else
  echo "  swap ${GRN}${swap_used}M / ${swap_tot}M (${swap_pct}%)${NC}"
fi
echo "  uptime$(uptime | sed 's/.*up \([^,]*,\{0,1\}[^,]*\), *[0-9]* user.*/ \1/')"

# ---- 1. orphaned runaways -------------------------------------------------
hdr "1. Orphaned runaways  ${DIM}(parent died, still burning CPU)${NC}"
found_any=0
while read -r pid ppid cpu cmd; do
  [ "$ppid" = "1" ] || continue
  ci=${cpu%.*}; [ "${ci:-0}" -ge "$HOT_CPU" ] || continue
  # A process that started seconds ago is busy, not abandoned. Every launch
  # spikes. Without this, ordinary system daemons get flagged the moment they
  # start doing their job.
  [ "$(etime_secs "$(etime_of "$pid")")" -ge "$ORPHAN_MIN_SECONDS" ] || continue
  echo "$(comm_of "$pid" | short)" | grep -qE "$NEVER_SPIN" && continue
  cwd=$(lsof -p "$pid" -a -d cwd 2>/dev/null | tail -1 | awk '{print $NF}')
  queue "$pid" "orphan $(echo "$cmd" | short) ${cwd:+[$(echo "$cwd" | sed "s|$HOME|~|")]}"
  found_any=1
done < <(ps -Ao pid=,ppid=,pcpu=,comm= -r | awk '{print $1, $2, $3, $4}')
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 1b. stuck spinners (parent alive) ------------------------------------
# The gap section 1 leaves. A process can spin forever under a perfectly
# healthy parent — nothing is orphaned, so parentage tells us nothing. What
# separates "stuck" from "legitimately busy" is CPU TIME: a build burns
# minutes, a spin loop burns hours. Both conditions must hold.
# Own-user only, so root daemons (WindowServer, kernel_task) are out of scope.
hdr "1b. Stuck spinners  ${DIM}(parent alive, but burning CPU for hours)${NC}"
found_any=0
while read -r pid ppid cpu ctime ucomm; do
  [ -n "$pid" ] || continue
  [ "$ppid" = "1" ] && continue                    # section 1's territory
  ci=${cpu%.*}; [ "${ci:-0}" -ge "$HOT_CPU" ] || continue
  secs=$(cpusecs "$ctime"); [ "${secs:-0}" -ge "$SPIN_CPU_SECONDS" ] || continue
  echo "$ucomm" | grep -qE "$NEVER_SPIN" && continue
  cwd=$(lsof -p "$pid" -a -d cwd 2>/dev/null | tail -1 | awk '{print $NF}')
  queue "$pid" "spinning $(hms "$secs") of CPU — $(echo "$ucomm" | short)${cwd:+ [$(echo "$cwd" | sed "s|$HOME|~|")]}"
  found_any=1
  # A spinner is often the child of a thin supervisor that would just restart
  # it. Take the parent too, but only when it is plainly a leftover wrapper:
  # orphaned itself and doing nothing.
  pcpu_p=$(cpu_of "$ppid"); pcpu_p=${pcpu_p%.*}
  if [ "$(ppid_of "$ppid")" = "1" ] && [ "${pcpu_p:-0}" -le 2 ]; then
    queue "$ppid" "  idle wrapper of $pid ($(comm_of "$ppid" | short))"
  fi
done < <(ps -U "$(id -un)" -o pid=,ppid=,pcpu=,time=,ucomm= -r)
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 2. leaked / orphaned MCP + automation servers ------------------------
hdr "2. Leaked automation servers  ${DIM}(MCP servers whose owner is gone)${NC}"
found_any=0
for pid in $(pgrep -f "$MCP_PATTERNS" 2>/dev/null); do
  alive "$pid" || continue
  pp=$(ppid_of "$pid")
  root=$(root_of "$pid")
  # leak if orphaned, or if the root ancestor is no longer alive
  if [ "$pp" = "1" ] || { [ -n "$root" ] && ! alive "$root"; }; then
    queue "$pid" "orphaned MCP server ($(comm_of "$pid" | short))"
    found_any=1
  fi
done
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 2b. duplicate MCP servers under one supervisor -----------------------
hdr "2b. Duplicate MCP servers  ${DIM}(same app spawned many, keeps newest)${NC}"
found_any=0
# bash 3.2 (macOS default) has no associative arrays, so build a plain
# "rootpid<TAB>signature<TAB>pid" table and group it with sort/awk.
# Group by the SUPERVISOR (grandparent), not the root app.
#
# This distinction matters. Every Claude Code session and the Claude app share
# the same root, so grouping by root makes 7 legitimately-separate sessions
# look like 7 duplicates. Their grandparents differ (one per session), while
# a leaking app spawns many servers under ONE shared grandparent. Grandparent
# is what actually separates "one per session" from "leaked pile".
TBL=$(for pid in $(pgrep -f "$MCP_PATTERNS" 2>/dev/null); do
  alive "$pid" || continue
  is_mcp "$pid" || continue                 # skips Chrome/Electron children
  pp=$(ppid_of "$pid"); [ -n "$pp" ] || continue
  gp=$(ppid_of "$pp");  [ -n "$gp" ] || gp=$pp
  sig=$(sig_of "$pid");  [ -n "$sig" ] || sig=$(comm_of "$pid" | short)
  printf '%s\t%s\t%s\n' "$gp" "$sig" "$pid"
done | sort -k1,1 -k2,2 -k3,3n)

# a group = same supervisor + same server signature, appearing more than once
while IFS=$'\t' read -r gp sig; do
  [ -n "$gp" ] || continue
  pids=$(echo "$TBL" | awk -F'\t' -v r="$gp" -v s="$sig" '$1==r && $2==s {print $3}')
  count=$(echo "$pids" | wc -l | tr -d ' ')
  [ "$count" -gt 1 ] || continue
  owner=$(comm_of "$(root_of "$gp")" | short); [ -n "$owner" ] || owner="pid $gp"
  newest=$(echo "$pids" | tail -1)          # highest pid = most recent, keep it
  for pid in $pids; do
    [ "$pid" = "$newest" ] && continue
    alive "$pid" || continue
    ci=$(cpu_of "$pid"); ci=${ci%.*}
    kids=$(pgrep -P "$pid" 2>/dev/null | wc -l | tr -d ' ')
    # only a leak if idle AND holding nothing (no live browser attached)
    [ "${ci:-0}" -le 2 ] && [ "$kids" -eq 0 ] || continue
    found_any=1
    if [ $DUPES -eq 1 ]; then
      queue "$pid" "duplicate $sig under $owner"
    else
      printf "    %s%-7s%s cpu=%-5s age=%-12s duplicate %s under %s ${DIM}(--dupes to kill)${NC}\n" \
        "$BLD" "$pid" "$NC" "$(cpu_of $pid)%" "$(etime_of $pid)" "$sig" "$owner"
      # reported but not queued: killing these needs --dupes
      row "$pid" "$SECTION" "needs-dupes-flag" "$(cpu_of $pid)" "$(etime_of $pid)" "duplicate $sig under $owner"
    fi
  done
done < <(echo "$TBL" | awk -F'\t' 'NF{print $1"\t"$2}' | sort -u)
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 3. headless browsers with no live owner ------------------------------
hdr "3. Stranded headless browsers"
found_any=0
for pid in $(pgrep -f "$HEADLESS_PATTERNS" 2>/dev/null); do
  alive "$pid" || continue
  pp=$(ppid_of "$pid")
  # only consider top-level browser processes (parent isn't itself headless)
  case "$(ps -o command= -p "$pp" 2>/dev/null)" in *chrome-headless-shell*) continue ;; esac
  root=$(root_of "$pid")
  if [ "$pp" = "1" ] || { [ -n "$root" ] && ! alive "$root"; }; then
    queue "$pid" "stranded headless browser (+children)"
    for k in $(pgrep -P "$pid" 2>/dev/null); do queue "$k" "  child of stranded browser"; done
    found_any=1
  fi
done
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 4. zombie app helpers ------------------------------------------------
hdr "4. Zombie app helpers  ${DIM}(app quit, helpers still running)${NC}"
found_any=0
for app in "${ZOMBIE_APPS[@]}"; do
  # "App is open, helpers expected" is this section's whole premise, and it is
  # also its blind spot: a RUNNING app can leak helpers for days and this loop
  # will never look at them. Sections 6/6b close that gap — they judge every
  # process by footprint alone, open parent app or not.
  pgrep -x "$app" >/dev/null 2>&1 && continue     # app is open, helpers expected
  for pid in $(pgrep -f "/$app\.app/.*(crashpad|Helper|gpu-process|utility|renderer)" 2>/dev/null); do
    queue "$pid" "$app zombie helper (app is closed)"
    found_any=1
  done
done
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 5. idle Claude Code sessions — REPORT ONLY ---------------------------
if [ $SHOW_SESSIONS -eq 1 ]; then
  hdr "5. Claude Code sessions  ${DIM}(report only — never killed by this script)${NC}"
  now=$(date +%s); any=0
  for pid in $(pgrep -f "claude-code/.*MacOS/claude" 2>/dev/null); do
    # pgrep -f also matches the Helpers/disclaimer wrapper (the claude path is
    # in its argv). Keep only processes that ARE the claude binary.
    case "$(ps -o comm= -p "$pid" 2>/dev/null)" in
      */claude.app/Contents/MacOS/claude) ;;
      *) continue ;;
    esac
    cwd=$(lsof -p "$pid" -a -d cwd 2>/dev/null | tail -1 | awk '{print $NF}')
    [ -n "$cwd" ] || continue
    d="$HOME/.claude/projects/$(echo "$cwd" | sed 's|[/.]|-|g')"
    newest=$(ls -t "$d"/*.jsonl 2>/dev/null | head -1)
    if [ -n "$newest" ]; then
      mins=$(( (now - $(stat -f %m "$newest")) / 60 ))
      idle=$(printf "%dh %02dm" $((mins/60)) $((mins%60)))
      if [ "$mins" -ge "$IDLE_SESSION_MINS" ]; then tag="${YLW}idle $idle${NC}"; else tag="${GRN}active $idle ago${NC}"; fi
    else
      tag="${DIM}unknown${NC}"; mins=0
    fi
    printf "    %-7s %-22s %s\n" "$pid" "$tag" "$(basename "$cwd")"
    row "$pid" "$SECTION" "never-killed" "$(cpu_of $pid)" "$(etime_of "$pid")" "Claude Code session in $(basename "$cwd"), idle ${mins}m"
    any=1
  done
  [ $any -eq 0 ] && echo "  ${GRN}none${NC}"
  echo "  ${DIM}Idle time is per worktree — two sessions in the same worktree share it.${NC}"
  echo "  ${DIM}To close one: switch to it in the Claude app and quit it there.${NC}"
  echo "  ${DIM}This script will not kill sessions — you'd lose unsaved work.${NC}"
fi

# The person's own OPEN apps are out of bounds for the memory sections: the
# binary a person launches from /Applications runs as launchd's direct child,
# so ppid 1 plus a top-level app path means "there is a Dock icon for this" —
# quitting it is their call, not this script's. Leaked helpers never look
# like that (their path nests under Frameworks/Helpers, or their parent is a
# helper that is still alive).
is_open_app() {
  [ "$(ppid_of "$1")" = "1" ] || return 1
  comm_of "$1" | grep -qE '^(/System)?/Applications/[^/]+\.app/Contents/MacOS/[^/]+$'
}

# ---- 6. idle memory hogs ---------------------------------------------------
# Every section above gates on CPU, and that blindness cost real damage: a
# backend process sat on 7 GB of footprint for 65 hours at 0% CPU until macOS
# ran out of application memory, and nothing here said a word. Big AND idle
# AND old is the tell — big alone is an app working, busy alone is a build.
hdr "6. Idle memory hogs  ${DIM}(holding a lot, doing nothing with it)${NC}"
found_any=0
while read -r pid mem cmp; do
  [ -n "$pid" ] || continue
  [ "${mem:-0}" -ge "$MEM_HOG_MB" ] || break      # map is sorted biggest-first
  alive "$pid" || continue
  [ "$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')" = "$(id -u)" ] || continue
  cpu=$(cpu_of "$pid"); ci=${cpu%.*}; [ "${ci:-0}" -lt "$MEM_HOG_MAX_CPU" ] || continue
  [ "$(etime_secs "$(etime_of "$pid")")" -ge "$MEM_HOG_MIN_SECONDS" ] || continue
  ucomm=$(ps -o ucomm= -p "$pid" 2>/dev/null | sed 's/ *$//')
  echo "$ucomm" | grep -qE "$NEVER_SPIN" && continue
  is_open_app "$pid" && continue
  queue_report "$pid" "holding $(mem_words "$mem"), $(mem_words "$cmp") of it cold — $(echo "$ucomm" | short)"
  found_any=1
done < <(printf '%s\n' "$MEMMAP")
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"

# ---- 6b. memory clone armies -----------------------------------------------
# The other way memory dies: not one fat process but dozens of identical small
# ones under a single parent, each too small for section 6 to notice, fatal in
# aggregate (49 leaked REPL children took part in the same incident). Grouped
# by parent + name; the group only counts when the COMBINED footprint is hog
# sized, so eight worker threads of a busy app stay uninteresting.
hdr "6b. Memory clone armies  ${DIM}(dozens of copies, huge added up)${NC}"
found_any=0
while IFS=$'\t' read -r pp cname count total pidlist; do
  [ -n "$pp" ] || continue
  echo "$cname" | grep -qE "$NEVER_SPIN" && continue
  # A crowd directly under an open app's own main process is that app's
  # working set — a browser's one-renderer-per-tab looks exactly like an army and
  # is exactly not one. The army that killed a machine nested one level
  # deeper, under a helper. (An army under a QUIT app still shows: its parent
  # is a leftover helper or launchd-adopted orphan, never the open binary.)
  is_open_app "$pp" && continue
  parent=$(comm_of "$pp" | short); [ -n "$parent" ] || parent="pid $pp"
  for pid in $pidlist; do
    alive "$pid" || continue
    queue_report "$pid" "one of $count $cname copies under $parent — $(mem_words "$total") between them"
  done
  found_any=1
done < <(ps -U "$(id -un)" -o pid=,ppid=,ucomm= | MM="$MEMMAP" awk -v need="$CLONE_COUNT" -v mb="$MEM_HOG_MB" '
  BEGIN { n = split(ENVIRON["MM"], L, "\n")
    for (i = 1; i <= n; i++) { split(L[i], f, " "); mem[f[1]] = f[2] } }
  { name = $3; for (i = 4; i <= NF; i++) name = name " " $i
    k = $2 "\t" name
    cnt[k]++; tot[k] += mem[$1] + 0; pids[k] = pids[k] " " $1 }
  END { for (k in cnt) if (cnt[k] >= need && tot[k] >= mb) printf "%s\t%d\t%d\t%s\n", k, cnt[k], tot[k], pids[k] }')
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"

# ---- summary --------------------------------------------------------------
echo
if [ "$MODE" = kill ]; then
  echo "${BLD}Done.${NC} killed ${RED}$KILLED${NC} process(es). log: ${DIM}$LOG${NC}"
  echo "${DIM}new load: $(uptime | sed 's/.*load averages*: //')${NC}"
else
  if [ $FOUND -eq 0 ]; then
    echo "${GRN}${BLD}Clean.${NC} nothing to reap."
  else
    echo "${BLD}Found $FOUND reapable process(es).${NC} run ${BLD}machogs kill${NC} to clean up."
  fi
fi
[ "$swap_pct" -gt 80 ] && echo "${YLW}Note:${NC} swap is ${swap_pct}% full — a restart is the only real fix for that."

# ---- machine-readable output ----------------------------------------------
# Restore the real stdout parked on fd 4 and print exactly one JSON object.
if [ "$JSON" -eq 1 ]; then
  exec 1>&4 4>&-
  printf '{\n'
  printf '  "mode": "%s",\n' "$MODE"
  printf '  "host": {"load": %s, "cores": %s, "swap_used_mb": %s, "swap_total_mb": %s, "swap_pct": %s, "uptime_days": %s},\n' \
    "${load:-0}" "${cores:-0}" "${swap_used:-0}" "${swap_tot:-0}" "${swap_pct:-0}" \
    "$(uptime | sed -n 's/.*up \([0-9]*\) day.*/\1/p' | head -1 | grep -E '^[0-9]+$' || echo 0)"
  printf '  "summary": {"reapable": %s, "killed": %s},\n' "$FOUND" "$KILLED"
  printf '  "findings": [\n'
  first=1
  while IFS=$'\t' read -r p sec act cpu age detail csec identity memmb; do
    [ -n "$p" ] || continue
    if [ -n "$TARGETS" ] && ! targeted "$p" "$identity"; then continue; fi
    # a queued process that flush_kills actually reaped is reported as killed
    case " $KILLED_PIDS " in *" $p "*) act="killed" ;; esac
    [ $first -eq 1 ] || printf ',\n'
    first=0
    # `story` is the line meant to be said out loud, verbatim. Without it every
    # agent writes its own and most of them are flat. `owner` and `what` are
    # the same halves broken out, so wrappers (the menu bar app) can log
    # closes in the format `machogs blame` reads.
    w=$(whatis "$p"); o=$(whose "$p")
    st=$(story "$sec" "$w" "$o" 1 "${cpu:-0}" "$age" "${csec:-0}" "${memmb:-0}")
    printf '    {"pid": %s, "identity": "%s", "section": "%s", "action": "%s", "cpu": %s, "cpu_seconds": %s, "memory_mb": %s, "age": "%s", "owner": "%s", "what": "%s", "detail": "%s", "story": "%s"}' \
      "$p" "$(jesc "$identity")" "$(jesc "$sec")" "$(jesc "$act")" "${cpu:-0}" "${csec:-0}" "${memmb:-0}" "$(jesc "$age")" "$(jesc "$o")" "$(jesc "$w")" "$(jesc "$detail")" "$(jesc "$st")"
  done < "$ROWS"
  [ $first -eq 0 ] && printf '\n'
  printf '  ]\n}\n'
fi

# ---- plain-language report and guided fix ---------------------------------
if [ "$HUMAN" -eq 1 ]; then
  exec 1>&4 4>&-

  # `kill` has already done the closing by now, so the findings it acted on are
  # dead and would filter out below — which read as "nothing found" right after
  # closing two things. Report the receipt instead.
  if [ "$MODE" = kill ]; then
    if [ "$KILLED" -gt 0 ]; then
      receipt "$FREED_CPU" "$FREED_CSEC" "$KILLED"
    else
      echo
      echo "${E_OK}${GRN}Nothing to close.${NC}"
    fi
    if [ "$swap_pct" -gt 80 ]; then
      echo
      echo "${YLW}Note:${NC} your Mac is out of fast memory after $(uptime | sed -n 's/.*up \([0-9]*\) day.*/\1/p' | head -1) days on."
      echo "Closing programs does not fix that. ${BLD}Restart when you can.${NC}"
    fi
    echo
    exit 0
  fi

  # everything the person could act on; sessions are informational only
  CANDIDATES=$(awk -F'\t' '$3=="reapable" || $3=="needs-dupes-flag"' "$ROWS")
  n=$(printf '%s' "$CANDIDATES" | grep -c . || true)

  echo
  if [ "${n:-0}" -eq 0 ]; then
    echo "${E_OK}${GRN}${BLD}Nothing is hogging your Mac.${NC}"
    echo "No stuck or abandoned programs are running. It's just vibing."
    if [ "$swap_pct" -gt 80 ]; then
      echo
      echo "${YLW}But your Mac has run out of fast memory.${NC}"
      echo "It has been on for $(uptime | sed -n 's/.*up \([0-9]*\) day.*/\1/p' | head -1) days and is now"
      echo "shuffling memory to disk, which makes everything slow."
      echo "${BLD}Restart it.${NC} That is the only thing that fixes this."
    elif [ "${loadint:-0}" -gt "$cores" ]; then
      echo
      echo "Your Mac is busy, but every program running is one you are using."
      echo "Close a few apps or browser tabs."
    else
      echo "If it still feels slow or hot, the cause is something else —"
      echo "check for a big download, a backup, or Spotlight rebuilding."
    fi
  else
    # Group identical findings. Key = section + what it is + who left it.
    # Aggregate: how many, the worst CPU in the group, the oldest age, the pids.
    ENR=$(mktemp -t machogs-enr) || exit 1
    while IFS=$'\t' read -r p sec act cpu age detail csec identity memmb; do
      [ -n "$p" ] || continue
      alive "$p" || continue
      # "-" not "": tab is IFS whitespace, so bash COLLAPSES an empty field and
      # every column after it shifts left. That reads as a working script right
      # up until it compares a timestamp against a number.
      o=$(whose "$p"); [ -n "$o" ] || o="-"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$sec" "$(whatis "$p")" "$o" "$cpu" "$age" "${csec:-0}" "${memmb:-0}" "$p" >> "$ENR"
    done < <(printf '%s\n' "$CANDIDATES")
    # Two things that will silently eat the rest of this block if you put them
    # back: a heredoc inside $( ), and a nested $( ) inside this multi-line
    # substitution. Both cost an hour to find. TAB is a plain variable for
    # exactly that reason.
    awk -F'\t' '
      { k=$1 "\t" $2 "\t" $3
        cnt[k]++
        if (!(k in cpu)) { cpu[k]=0; scpu[k]=0; scsec[k]=0; smem[k]=0 }
        if ($4+0 > cpu[k]+0) cpu[k]=$4+0
        scpu[k]  += $4+0          # total CPU% the whole group is holding
        scsec[k] += $6+0          # total CPU seconds the group has burned
        smem[k]  += $7+0          # total footprint MB the group is sitting on
        if (length($5) > length(age[k]) || (length($5)==length(age[k]) && $5>age[k])) age[k]=$5
        pids[k] = (k in pids ? pids[k] " " : "") $8 }
      END { for (k in cnt) printf "%s\t%d\t%s\t%s\t%.1f\t%d\t%d\t%s\n",
              k, cnt[k], cpu[k], age[k], scpu[k], scsec[k], smem[k], pids[k] }
    ' "$ENR" | sort -t"$TAB" -k5,5nr -k7,7nr > "$GRP"
    rm -f "$ENR"
    ngroups=$(wc -l < "$GRP" | tr -d ' ')
    # is anything actually burning CPU, or is this all idle clutter?
    hot=$(awk -F'\t' '$5+0 >= 20' "$GRP" | wc -l | tr -d ' ')

    if [ "$MODE" = fix ]; then
      echo "${E_BROOM}${BLD}Found $(count_unit "$ngroups" thing) worth closing.${NC}"
      echo "${DIM}I will ask before each one. Nothing closes unless you say yes.${NC}"
    elif [ "${hot:-0}" -gt 1 ]; then
      echo "${E_PIG}${BLD}Found the hogs.${NC} ${DIM}Caught in 4K. Receipts below.${NC}"
    elif [ "${hot:-0}" -gt 0 ]; then
      echo "${E_PIG}${BLD}Found the hog.${NC} ${DIM}Caught in 4K. Receipts below.${NC}"
    else
      echo "${E_ZZZ}${BLD}Nothing is eating your CPU right now.${NC}"
      echo "${DIM}But $(count_unit "$n" "abandoned program") $([ "$n" -eq 1 ] && echo is || echo are) sitting in memory.${NC}"
    fi
    echo

    i=0; closed=0; freed_cpu=0; freed_csec=0
    while IFS=$'\t' read -r sec what owner count cpu age scpu scsec smem pidlist; do
      [ -n "$sec" ] || continue
      i=$((i+1))
      [ "$MODE" = fix ] && echo "${DIM}${i} of ${ngroups}${NC}"
      say_group "$sec" "$what" "$owner" "$count" "$cpu" "$age" "$smem"
      if [ "$MODE" = fix ]; then
        echo
        if [ "$count" -gt 1 ]; then
          printf "  Close all %s? [y/N] " "$count"
        else
          printf "  Close it? [y/N] "
        fi
        read -r ans </dev/tty
        case "$ans" in
          y|Y|yes|YES)
            for p in $pidlist; do
              alive "$p" || continue
              if kill -9 "$p" 2>/dev/null; then
                closed=$((closed+1))
                logclose "$p" "$owner" "$what" "$cpu" "$scsec"
              fi
            done
            freed_cpu=$(awk -v a="$freed_cpu" -v b="$scpu" 'BEGIN{printf "%.1f", a+b}')
            freed_csec=$((freed_csec + scsec))
            echo "  ${GRN}Closed.${NC}" ;;
          *) echo "  ${DIM}Left alone.${NC}" ;;
        esac
      fi
      echo
    done < "$GRP"

    if [ "$MODE" = fix ]; then
      if [ "$closed" -gt 0 ]; then
        receipt "$freed_cpu" "$freed_csec" "$closed"
        [ "${hot:-0}" -gt 0 ] && echo "Your fan should quiet down over the next few minutes."
      else
        echo "${DIM}Nothing was closed.${NC}"
      fi
    else
      # Only claim the symptoms something is actually causing.
      if [ "${hot:-0}" -gt 0 ]; then
        echo "${BLD}This is why your Mac feels slow, runs hot, spins its fan,${NC}"
        echo "${BLD}and loses battery faster than it should.${NC}"
      else
        echo "These are not making your fan spin — none of them are busy."
        echo "They waste memory, which matters once memory runs short."
      fi
      echo
      echo "To go through them one at a time:  ${BLD}machogs fix${NC}"
      echo "${DIM}Nothing is closed unless you say yes.${NC}"
    fi

    if [ "$swap_pct" -gt 80 ]; then
      echo
      echo "${YLW}Also:${NC} your Mac has been on for $(uptime | sed -n 's/.*up \([0-9]*\) day.*/\1/p' | head -1) days and is out of fast memory."
      echo "Closing programs will not fix that part. ${BLD}Restart when you can.${NC}"
    fi
  fi
  echo

  # kills in fix mode are counted here, not by flush_kills
  KILLED=$((KILLED + ${closed:-0}))
  if [ "$MODE" = report ] && [ "${n:-0}" -gt 0 ]; then exit 10; fi
  exit 0
fi

# Exit code is the verdict, so a caller need not parse anything at all.
#   0  clean, or a kill run that finished
#  10  report mode with findings a human should look at
if [ "$MODE" = report ] && [ "$FOUND" -gt 0 ]; then exit 10; fi
exit 0
