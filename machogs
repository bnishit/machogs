#!/bin/bash
# machogs — find out what is hogging your Mac.
#
# Slow, hot, loud fan, battery gone by lunch: usually one program eating a CPU
# core that nobody is using any more. This finds it and tells you in plain words.
#
#   machogs                 plain answer (default, never closes anything)
#   machogs fix             go through them one at a time, asking before each
#   machogs blame           scoreboard: which app leaves the most junk behind
#   machogs brag            a shareable card of what your Mac has wasted
#   machogs --details       the technical report, by category
#   machogs kill            close everything reapable, no questions (scripts)
#   machogs kill --dupes    also close duplicate MCP servers (keeps newest)
#   machogs --sessions      list Claude Code sessions too (never closed)
#   machogs --json          machine-readable output, for agents (see below)
#
# FOR AGENTS: `--json` prints one JSON object on stdout and nothing else, so it
# can be parsed without scraping colours or column layout. Exit codes carry the
# verdict, so a wrapper does not have to parse anything at all:
#   0  clean — nothing worth reaping (or: kill finished)
#  10  findings exist, report mode — a human should look
#   2  bad arguments
# --json is a reporting flag. It never kills on its own; pair it with `kill`.
#
# SAFETY RULES, in order of importance:
#   1. Never kills anything in this script's own process ancestry.
#   2. Never kills a Claude Code session. Ever. It only reports them.
#      (You code in the Claude app — killing a session loses live work.)
#   3. Report mode is the default. `kill` is always explicit.
#
# Section 1 only catches runaways whose PARENT DIED. That missed the real
# thing (a plugin server spinning at 90% for four days under a live wrapper),
# so section 1b catches spinners whose parent is alive, using accumulated CPU
# TIME rather than parentage: hot right now AND hours of CPU burned = stuck.
#
# Supersedes debug-bun (bun + zombie apps only). Logs kills to
# ~/Library/Logs/machogs.log
set -uo pipefail

# ---- config ---------------------------------------------------------------
# Both are env-overridable so the detector can be exercised without waiting
# four hours for a real spinner:  SPIN_CPU_SECONDS=5 machogs
HOT_CPU=${HOT_CPU:-50}                 # %CPU above which a process counts as hot
SPIN_CPU_SECONDS=${SPIN_CPU_SECONDS:-14400}  # 4h CPU + hot now = stuck, not busy
ORPHAN_MIN_SECONDS=${ORPHAN_MIN_SECONDS:-300} # an orphan must have lasted 5 min
IDLE_SESSION_MINS=180      # a Claude Code session idle this long gets flagged
# Processes that legitimately pin a core for hours. Matched against ucomm.
NEVER_SPIN="WindowServer|kernel_task|launchd|ffmpeg|HandBrake|Compressor|backupd|mds|mds_stores|mdworker|photoanalysisd"
ZOMBIE_APPS=("Cursor" "Code" "Electron")   # apps that leak helpers after quitting
# process patterns treated as "MCP / automation servers"
MCP_PATTERNS="playwright-mcp|@playwright/mcp|mcp-server-|/mcp/server\.(c|m)?js|modelcontextprotocol"
HEADLESS_PATTERNS="chrome-headless-shell|--headless"
# Browser/Electron child processes always carry --type=. They are never MCP
# servers, even when their --user-data-dir path happens to contain "mcp".
NOT_MCP="--type=|Google Chrome|Chromium|chrome-headless-shell"

LOG="$HOME/Library/Logs/machogs.log"
TAB=$'\t'
RED=$'\033[0;31m'; GRN=$'\033[0;32m'; YLW=$'\033[0;33m'; BLU=$'\033[0;34m'
DIM=$'\033[2m'; BLD=$'\033[1m'; NC=$'\033[0m'
[ -t 1 ] || { RED=; GRN=; YLW=; BLU=; DIM=; BLD=; NC=; }

MODE=report; DUPES=0; SHOW_SESSIONS=0; JSON=0; DETAILS=0
for a in "$@"; do
  case "$a" in
    kill)        MODE=kill ;;
    fix)         MODE=fix ;;
    blame)       MODE=blame ;;
    brag)        MODE=brag ;;
    --dupes)     DUPES=1 ;;
    --sessions)  SHOW_SESSIONS=1 ;;
    --check)     MODE=check ;;
    --json)      JSON=1 ;;
    --details)   DETAILS=1 ;;
    -h|--help)   sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $a (try --help)" >&2; exit 2 ;;
  esac
done

# `fix` confirms every single close with the person sitting there, so the
# --dupes gate is redundant: it exists to stop unattended runs reaping things
# nobody looked at. An attended run looks at all of them.
[ "$MODE" = fix ] && DUPES=1

# Plain language is the default. --details, --json and --check are the ways to
# ask for the technical view instead.
HUMAN=1
if [ "$DETAILS" -eq 1 ] || [ "$JSON" -eq 1 ] || [ "$MODE" = check ]; then HUMAN=0; fi
if [ "$MODE" = fix ]; then HUMAN=1; fi

if [ "$MODE" = fix ] && [ ! -t 0 ]; then
  echo "machogs fix needs a terminal to ask you questions." >&2
  echo "For unattended use run: machogs kill" >&2
  exit 2
fi

# Findings are always recorded to a scratch file, whether or not --json was
# asked for; it costs nothing and keeps the reporting code in one place.
ROWS=$(mktemp -t machogs-rows) || exit 1
GRP=$(mktemp -t machogs-groups) || exit 1
trap 'rm -f "$ROWS" "$GRP"' EXIT

# row <pid> <category> <action> <cpu> <age> <detail>
# Tab-separated. Nothing here may contain a tab or newline; the fields are all
# pids, numbers, and process names, so that holds.
row() { printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$(cputime_of "$1")" >> "$ROWS"; }

# Total CPU seconds this process has consumed since it started.
cputime_of() { cpusecs "$(ps -o time= -p "$1" 2>/dev/null | tr -d ' ')"; }

# The log is the scoreboard. Written tab-separated so `machogs blame` can add
# it up months later: when, pid, which app is to blame, what it was, and what
# it cost. Free-text log lines from older versions still parse — badly — so
# blame treats anything it cannot read as "unknown".
# logclose <pid> <owner> <what> <cpu%> <cpu-seconds>
logclose() {
  local owner=${2:-unknown}; [ "$owner" = "-" ] && owner="unknown"
  printf '%s\tclosed\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date '+%F %T')" "$1" "$owner" "${3:-program}" "${4:-0}" "${5:-0}" >> "$LOG"
}

# ---- plain language -------------------------------------------------------
# Everything below exists to answer one question a normal person actually asks:
# "what is this thing and is it safe to close?" A pid and a percentage do not
# answer that. The name of the app that left it behind does.

# Two separate questions, because the answers come from different places:
# WHAT is this thing, and WHICH APP left it here. "node" answers neither.
# The owning app is the useful half — it is the thing the person recognises
# and, usually, the thing they should quit or update.

hay_for() {
  local pid=$1
  printf '%s %s %s' \
    "$(ps -o command= -p "$pid" 2>/dev/null)" \
    "$(lsof -p "$pid" -a -d cwd 2>/dev/null | tail -1 | awk '{print $NF}')" \
    "$(ps -o command= -p "$(root_of "$pid")" 2>/dev/null)"
}

# Which app is responsible. Checked before what-it-is, because an app name
# beats a category every time.
whose() {
  case "$(hay_for "$1")" in
    *ChatGPT*)                  echo "ChatGPT" ;;
    *[Cc]odex*)                 echo "Codex" ;;
    *.claude/plugins*)          echo "a Claude Code plugin" ;;
    *claude-code*|*Claude.app*) echo "Claude Code" ;;
    *Cursor*)                   echo "Cursor" ;;
    *[Ww]indsurf*)              echo "Windsurf" ;;
    *Visual\ Studio\ Code*|*/Code\ Helper*) echo "VS Code" ;;
    *) echo "" ;;
  esac
}

# What kind of thing it is, in words rather than process names.
whatis() {
  local pid=$1
  case "$(hay_for "$pid")" in
    *playwright*)          echo "browser-control helper" ;;
    *chrome-headless*)     echo "hidden browser window" ;;
    *mcp*|*modelcontext*)  echo "AI tool helper" ;;
    *crashpad*)            echo "crash reporter" ;;
    *) local n; n=$(ps -o ucomm= -p "$pid" 2>/dev/null | sed 's/ *$//')
       echo "${n:-background program}" ;;
  esac
}

# etime -> seconds. Formats: "00:01", "01:29:07", "04-01:37:50".
etime_secs() {
  echo "$1" | awk -F- '
    { t = (NF==2 ? $2 : $1); d = (NF==2 ? $1 : 0)
      n = split(t, a, ":")
      s = (n==3 ? a[1]*3600 + a[2]*60 + a[3] : a[1]*60 + a[2])
      printf "%d", d*86400 + s }'
}

# n + unit, pluralised, no leading zeros. "04" -> "4 days", "1" -> "1 day".
count_unit() {
  local d; d=$(printf '%s' "${1:-0}" | tr -cd '0-9'); [ -n "$d" ] || d=0
  local n=$((10#$d)) u=$2
  [ "$n" -eq 1 ] && { echo "1 $u"; return; }
  echo "$n ${u}s"
}

# "04-01:37:50" (4 days) or "01:29:07" (1.5 hours) -> words.
plain_age() {
  case "$1" in
    *-*)   count_unit "$(echo "$1" | cut -d- -f1)" day ;;
    *:*:*) count_unit "$(echo "$1" | cut -d: -f1)" hour ;;
    *)     count_unit "$(echo "$1" | cut -d: -f1)" minute ;;
  esac
}

# What a section means for the person, not for the process table.
why_line() {
  case "$1" in
    1)  echo "It kept running after the app that started it closed." ;;
    1b) echo "It is stuck in a loop. Nothing is waiting for it." ;;
    2)  echo "The app that started it is gone, but it never stopped." ;;
    2b) echo "A duplicate. One app started the same helper many times over." ;;
    3)  echo "A hidden browser window nobody is looking at." ;;
    4)  echo "The app was closed, but this piece of it stayed behind." ;;
    *)  echo "" ;;
  esac
}

# ---- stories ---------------------------------------------------------------
# The tool knows the good version of the sentence. If it does not say it, every
# agent invents its own and most of them are flat. story() is the line meant to
# be repeated out loud, to a person, verbatim.

# 328000 -> "91 hours". 5400 -> "1.5 hours". 300 -> "5 minutes".
burned() {
  awk -v s="${1:-0}" 'BEGIN{
    if (s >= 864000) { printf "%.0f days", s/86400 }
    else if (s >= 7200) { printf "%d hours", s/3600 }
    else if (s >= 3600) { printf "1 hour" }
    else if (s >= 120) { printf "%d minutes", s/60 }
    else if (s >= 60) { printf "1 minute" }
    else { printf "%d seconds", s }
  }'
}

article() {
  local a="A"; [ "${2:-}" = lower ] && a="a"
  case "$1" in [AaEeIiOoUu]*) echo "${a}n" ;; *) echo "$a" ;; esac
}

# story <sec> <what> <owner> <count> <cpu> <age> <cpusecs>
# Always ends up capitalised — the owner can legitimately be "a Claude Code
# plugin", which would otherwise start the sentence in lower case.
story() { _story "$@" | awk '{ print toupper(substr($0,1,1)) substr($0,2) }' | tr -d '\n'; }
_story() {
  local sec=$1 what=$2 owner=$3 count=$4 cpu=$5 age=$6 csec=$7
  [ "$owner" = "-" ] && owner=""
  if [ "$sec" = "5" ]; then
    printf 'One of your live Claude Code sessions, running %s. Never closed by this tool.' \
      "$(plain_age "$age")"
    return
  fi
  local who="Something"; [ -n "$owner" ] && who="$owner"
  local ci=${cpu%.*}

  if [ "${ci:-0}" -ge 20 ]; then
    # the headline case: it is on fire, and the burned total is the punchline
    if [ -n "$owner" ]; then
      printf '%s left %s %s running at %s%% of a CPU core for %s. It has burned %s of processor time.' \
        "$who" "$(article "$what" lower)" "$what" "$cpu" "$(plain_age "$age")" "$(burned "$csec")"
    else
      printf '%s %s is stuck at %s%% of a CPU core and has been for %s, burning %s of processor time.' \
        "$(article "$what")" "$what" "$cpu" "$(plain_age "$age")" "$(burned "$csec")"
    fi
  elif [ "$count" -gt 1 ]; then
    printf '%s quietly started %s copies of the same %s. All idle, none cleaned up, oldest sitting there %s.' \
      "$who" "$count" "$what" "$(plain_age "$age")"
  elif [ -n "$owner" ]; then
    printf '%s left %s %s behind. Idle for %s, and nothing is using it.' \
      "$who" "$(article "$what" lower)" "$what" "$(plain_age "$age")"
  else
    printf '%s %s has been idle for %s with nothing using it.' "$(article "$what")" "$what" "$(plain_age "$age")"
  fi
}

# The receipt. Closing a process is an event; getting a core back is a result.
# Same action, and only one of them is worth telling someone about.
#
# The battery line is an ESTIMATE and says so. A core at full tilt costs roughly
# 6W on Apple silicon, against a machine that idles near 8W, so freeing a full
# core really is worth hours — but it depends on the Mac, so we never print a
# precise number we cannot stand behind.
receipt() {
  local cpu_freed=$1 csec_freed=$2 nclosed=$3
  local cores; cores=$(awk -v c="${cpu_freed:-0}" 'BEGIN{printf "%.1f", c/100}')
  echo
  echo "${GRN}${BLD}Closed $(count_unit "$nclosed" program).${NC}"
  if [ "$(awk -v c="${cores:-0}" 'BEGIN{print (c>=0.2)?1:0}')" = "1" ]; then
    echo "You just got back ${BLD}${cores} of a CPU core${NC} that nothing was using."
  fi
  if [ "${csec_freed:-0}" -ge 600 ]; then
    echo "They had already burned ${BLD}$(burned "$csec_freed")${NC} of processor time."
  fi
  # what it would have cost by tomorrow if left alone
  if [ "$(awk -v c="${cpu_freed:-0}" 'BEGIN{print (c>=20)?1:0}')" = "1" ]; then
    local tomorrow; tomorrow=$(awk -v c="$cpu_freed" 'BEGIN{printf "%d", (c/100)*86400}')
    echo "Left alone, they would have burned ${BLD}$(burned "$tomorrow")${NC} more by this time tomorrow."
    echo "${DIM}Roughly an hour or two of battery back, depending on your Mac.${NC}"
  fi
}

# One GROUP of identical findings, as a few lines of English. Seven copies of
# the same leaked helper is one problem, not seven, and reading it seven times
# teaches the person nothing.
say_group() {
  local sec=$1 what=$2 owner=$3 count=$4 cpu=$5 age=$6
  [ "$owner" = "-" ] && owner=""
  local head="$what"
  [ "$count" -gt 1 ] && head="$what ${DIM}× ${count}${NC}"
  if [ -n "$owner" ]; then
    echo "  ${BLD}${head}${NC} ${DIM}— left by ${owner}${NC}"
  else
    echo "  ${BLD}${head}${NC}"
  fi
  local ci=${cpu%.*}
  if [ "${ci:-0}" -ge 20 ]; then
    echo "  Eating ${RED}${cpu}%${NC} of a CPU core. Running for $(plain_age "$age")."
  elif [ "$count" -gt 1 ]; then
    echo "  Idle, but holding memory. Oldest has sat there $(plain_age "$age")."
  else
    echo "  Idle, but holding memory. Sitting there $(plain_age "$age")."
  fi
  local why; why=$(why_line "$sec")
  [ -n "$why" ] && echo "  ${DIM}${why}${NC}"
}

# Minimal JSON string escaping: backslash and double quote only. No control
# characters can reach here — every value is a pid, number, or process name.
jesc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# ---- helpers --------------------------------------------------------------
ppid_of()  { ps -o ppid= -p "$1" 2>/dev/null | tr -d ' '; }
comm_of()  { ps -o comm= -p "$1" 2>/dev/null; }
cpu_of()   { ps -o pcpu= -p "$1" 2>/dev/null | tr -d ' '; }
etime_of() { ps -o etime= -p "$1" 2>/dev/null | tr -d ' '; }
alive()    { kill -0 "$1" 2>/dev/null; }
short()    { sed 's|.*/||' | cut -c1-46; }

# macOS ps prints TIME as MMMM:SS.ss — minutes are NOT wrapped at 60
# ("6638:43.89" is 110 hours). Convert to whole seconds.
cpusecs() { echo "${1:-0:0}" | awk -F: '{printf "%d", $1*60 + $2}'; }
hms()     { awk -v s="$1" 'BEGIN{printf "%dh%02dm", s/3600, (s%3600)/60}'; }

# Walk up the process tree, printing every ancestor pid.
ancestry() {
  local cur=$1 hops=0
  while [ -n "$cur" ] && [ "$cur" != "0" ] && [ "$cur" != "1" ] && [ $hops -lt 12 ]; do
    echo "$cur"; cur=$(ppid_of "$cur"); hops=$((hops+1))
  done
}
root_of() { ancestry "$1" | tail -1; }

# Is this a real MCP server process, or a browser child that merely has "mcp"
# somewhere in its command line?
is_mcp() {
  local cmd; cmd=$(ps -o command= -p "$1" 2>/dev/null)
  [ -n "$cmd" ] || return 1
  # -e is required: NOT_MCP starts with "--", which grep would read as a flag
  echo "$cmd" | grep -qE -e "$NOT_MCP" && return 1
  echo "$cmd" | grep -qE -e "$MCP_PATTERNS"
}

# A stable signature for "the same server started twice": the script/binary it
# runs, ignoring paths and per-run flags.
sig_of() {
  ps -o command= -p "$1" 2>/dev/null | tr ' ' '\n' \
    | grep -vE '^-|^$' | sed -n '2p' | sed 's|.*/||'
}

# Rule 1: never touch our own ancestry.
SELF_SAFE=" $(ancestry $$ | tr '\n' ' ') "
# Rule 2: never touch Claude Code / the Claude app.
claude_app_pids() { pgrep -f "claude-code/.*MacOS/claude|Claude\.app/Contents/MacOS/Claude" 2>/dev/null; }
CLAUDE_SAFE=" $(claude_app_pids | tr '\n' ' ') "

protected() {
  local pid=$1 a
  # protected if the process itself, OR any of its ancestors, is our own
  # session or a live Claude Code session. This is the net that stops us
  # reaping the MCP servers belonging to sessions you're actively coding in.
  for a in $pid $(ancestry "$pid"); do
    case "$SELF_SAFE"   in *" $a "*) return 0 ;; esac
    case "$CLAUDE_SAFE" in *" $a "*) return 0 ;; esac
  done
  return 1
}

# ---- blame / brag ---------------------------------------------------------
# Reading the scoreboard. Both are read-only and touch no processes at all.
# The data is a fact only this tool can produce: which app leaks most on YOUR
# machine, measured, over months.

blame_table() {
  awk -F'\t' '
    $2=="closed" { app=$4; n[app]++; secs[app]+=$7; if ($7+0 > worst[app]+0) worst[app]=$7+0; next }
    # older free-text lines, two shapes:
    #   "... closed 123 — browser-control helper (ChatGPT)"
    #   "... killed 123 — duplicate server.cjs under ChatGPT"
    { if (match($0, /\(([^)]+)\)$/))      { app=substr($0, RSTART+1, RLENGTH-2); n[app]++ }
      else if (match($0, / under .+$/))   { app=substr($0, RSTART+7); n[app]++ }
      else n["unknown"]++ }
    END { for (a in n) printf "%d\t%d\t%d\t%s\n", n[a], secs[a], worst[a], a }
  ' "$LOG" 2>/dev/null | sort -rn
}

if [ "$MODE" = blame ] || [ "$MODE" = brag ]; then
  if [ ! -s "$LOG" ]; then
    echo "Nothing closed yet — no scoreboard to show."
    echo "${DIM}Run ${BLD}machogs fix${NC}${DIM} first.${NC}"
    exit 0
  fi
  total_n=0; total_s=0; worst_s=0; worst_app=""; first_seen=""
  first_seen=$(head -1 "$LOG" | cut -c1-10)
  BL=$(blame_table)

  if [ "$MODE" = blame ]; then
    echo
    echo "${BLD}Who leaves the most junk on your Mac${NC}"
    echo "${DIM}since ${first_seen}${NC}"
    echo
    printf "  %-26s %8s   %s\n" "APP" "CLOSED" "CPU TIME WASTED"
    while IFS=$'\t' read -r n secs worst app; do
      [ -n "$app" ] || continue
      printf "  %-26s %8s   %s\n" "$app" "$n" "$(burned "$secs")"
    done < <(printf '%s\n' "$BL")
    echo
  fi

  while IFS=$'\t' read -r n secs worst app; do
    [ -n "$app" ] || continue
    total_n=$((total_n + n)); total_s=$((total_s + secs))
    if [ "${worst:-0}" -gt "$worst_s" ]; then worst_s=$worst; worst_app=$app; fi
  done < <(printf '%s\n' "$BL")

  if [ "$MODE" = brag ]; then
    top=$(printf '%s\n' "$BL" | head -1)
    top_app=$(printf '%s' "$top" | cut -f4); top_n=$(printf '%s' "$top" | cut -f1)
    echo
    echo "  ---------------------------------------------"
    echo "   my mac was doing $(burned "$total_s") of work"
    echo "   for programs i never opened."
    echo
    echo "   $total_n background programs closed"
    [ -n "$top_app" ] && echo "   worst offender: $top_app ($top_n of them)"
    [ "${worst_s:-0}" -gt 3600 ] && echo "   single worst: $(burned "$worst_s") burned by one process"
    echo
    echo "   found with machogs"
    echo "   github.com/bnishit/machogs"
    echo "  ---------------------------------------------"
    echo
    echo "${DIM}Copy the block above. That is the post.${NC}"
    echo
  fi
  exit 0
fi

# --check: prove the safety net works. Lists every automation process and
# whether the script would refuse to kill it, and why. Kills nothing.
if [ "$MODE" = check ]; then
  echo "${BLD}=== machogs --check ===${NC}  ${DIM}safety audit, kills nothing${NC}"
  echo "  own ancestry protected : $(echo $SELF_SAFE | wc -w | tr -d ' ') pids"
  echo "  Claude Code protected  : $(echo $CLAUDE_SAFE | wc -w | tr -d ' ') pids"
  echo
  printf "  %-8s %-11s %-18s %s\n" PID VERDICT OWNER COMMAND
  for pid in $(pgrep -f "$MCP_PATTERNS" 2>/dev/null); do
    alive "$pid" || continue
    is_mcp "$pid" || continue
    owner=$(comm_of "$(root_of "$pid")" | short)
    if protected "$pid"; then v="${GRN}PROTECTED${NC}"; else v="${YLW}reapable${NC} "; fi
    printf "  %-8s %-22b %-18s %s\n" "$pid" "$v" "${owner:-?}" "$(sig_of "$pid")"
  done
  echo
  echo "  ${DIM}Anything owned by Claude Code must read PROTECTED.${NC}"
  exit 0
fi

# --check is a human audit and prints its own report, so the redirect goes in
# below it. In --json and plain-language modes the technical report still runs
# — it is simply sent to /dev/null, so the output paths can never drift apart.
# Real stdout is parked on fd 4 and restored at the end.
if [ "$JSON" -eq 1 ] || [ "$HUMAN" -eq 1 ]; then exec 4>&1 1>/dev/null; fi

KILLED=0; FOUND=0; KILLED_PIDS=""; FREED_CPU=0; FREED_CSEC=0
declare -a KILL_LIST=()

# queue <pid> <reason>
queue() {
  local pid=$1 reason=$2
  alive "$pid" || return
  if protected "$pid"; then
    printf "    %sskip%s %-7s %s ${DIM}(protected: own session / Claude Code)${NC}\n" "$DIM" "$NC" "$pid" "$reason"
    row "$pid" "$SECTION" "protected" "$(cpu_of $pid)" "$(etime_of $pid)" "$reason"
    return
  fi
  FOUND=$((FOUND+1))
  KILL_LIST+=("$pid|$reason")
  printf "    %s%-7s%s cpu=%-5s age=%-12s %s\n" "$BLD" "$pid" "$NC" "$(cpu_of $pid)%" "$(etime_of $pid)" "$reason"
  row "$pid" "$SECTION" "reapable" "$(cpu_of $pid)" "$(etime_of $pid)" "$reason"
}

flush_kills() {
  [ "$MODE" = kill ] || return
  [ ${#KILL_LIST[@]} -eq 0 ] && return
  echo
  echo "  ${YLW}killing ${#KILL_LIST[@]} process(es)...${NC}"
  local entry pid reason
  for entry in "${KILL_LIST[@]}"; do
    pid=${entry%%|*}; reason=${entry#*|}
    alive "$pid" || continue
    # read the identity BEFORE killing; afterwards ps knows nothing about it
    local who what cpu csec
    who=$(whose "$pid"); what=$(whatis "$pid")
    cpu=$(cpu_of "$pid"); csec=$(cputime_of "$pid")
    if kill -9 "$pid" 2>/dev/null; then
      KILLED=$((KILLED+1))
      KILLED_PIDS="$KILLED_PIDS $pid"
      FREED_CPU=$(awk -v a="$FREED_CPU" -v b="${cpu:-0}" 'BEGIN{printf "%.1f", a+b}')
      FREED_CSEC=$((FREED_CSEC + csec))
      logclose "$pid" "$who" "$what" "$cpu" "$csec"
      echo "    ${RED}killed${NC} $pid ${DIM}($reason)${NC}"
    fi
  done
  KILL_LIST=()
}

# Printing a section header is also what sets the section id used by row(), so
# the two can never disagree about which bucket a finding landed in. "1b. Stuck
# spinners ..." -> SECTION=1b.
SECTION="0"
hdr() {
  SECTION=$(printf '%s' "$1" | sed 's/\..*//')
  echo; echo "${BLU}${BLD}$1${NC}"
}

# ---- 0. system health -----------------------------------------------------
cores=$(sysctl -n hw.ncpu)
# macOS: "load averages: 4.61 5.18 6.01" (space separated, no commas)
load=$(uptime | sed 's/.*load averages*: *//' | awk '{print $1}' | tr -d ',')
# macOS: "total = 16384.00M  used = 15131.31M  free = 1252.69M  (encrypted)"
swap_tot=$(sysctl -n vm.swapusage  | awk '{print $3}' | tr -d 'M')
swap_used=$(sysctl -n vm.swapusage | awk '{print $6}' | tr -d 'M')

echo "${BLD}=== machogs ===${NC}  ${DIM}$(date '+%F %H:%M')  ·  mode: $MODE${NC}"
hdr "System"
loadint=${load%.*}
if [ "${loadint:-0}" -gt "$cores" ]; then
  echo "  load ${RED}$load${NC} on $cores cores  ${RED}<- oversubscribed${NC}"
else
  echo "  load ${GRN}$load${NC} on $cores cores"
fi
swap_pct=$(awk -v u="${swap_used:-0}" -v t="${swap_tot:-1}" 'BEGIN{printf "%d", (u/t)*100}')
if [ "$swap_pct" -gt 80 ]; then
  echo "  swap ${RED}${swap_used}M / ${swap_tot}M (${swap_pct}%)${NC}  ${RED}<- thrashing, reboot to clear${NC}"
else
  echo "  swap ${GRN}${swap_used}M / ${swap_tot}M (${swap_pct}%)${NC}"
fi
echo "  uptime$(uptime | sed 's/.*up \([^,]*,\{0,1\}[^,]*\), *[0-9]* user.*/ \1/')"

# ---- 1. orphaned runaways -------------------------------------------------
hdr "1. Orphaned runaways  ${DIM}(parent died, still burning CPU)${NC}"
found_any=0
while read -r pid ppid cpu cmd; do
  [ "$ppid" = "1" ] || continue
  ci=${cpu%.*}; [ "${ci:-0}" -ge "$HOT_CPU" ] || continue
  # A process that started seconds ago is busy, not abandoned. Every launch
  # spikes. Without this, ordinary system daemons get flagged the moment they
  # start doing their job.
  [ "$(etime_secs "$(etime_of "$pid")")" -ge "$ORPHAN_MIN_SECONDS" ] || continue
  echo "$(comm_of "$pid" | short)" | grep -qE "$NEVER_SPIN" && continue
  cwd=$(lsof -p "$pid" -a -d cwd 2>/dev/null | tail -1 | awk '{print $NF}')
  queue "$pid" "orphan $(echo "$cmd" | short) ${cwd:+[$(echo "$cwd" | sed "s|$HOME|~|")]}"
  found_any=1
done < <(ps -Ao pid=,ppid=,pcpu=,comm= -r | awk '{print $1, $2, $3, $4}')
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 1b. stuck spinners (parent alive) ------------------------------------
# The gap section 1 leaves. A process can spin forever under a perfectly
# healthy parent — nothing is orphaned, so parentage tells us nothing. What
# separates "stuck" from "legitimately busy" is CPU TIME: a build burns
# minutes, a spin loop burns hours. Both conditions must hold.
# Own-user only, so root daemons (WindowServer, kernel_task) are out of scope.
hdr "1b. Stuck spinners  ${DIM}(parent alive, but burning CPU for hours)${NC}"
found_any=0
while read -r pid ppid cpu ctime ucomm; do
  [ -n "$pid" ] || continue
  [ "$ppid" = "1" ] && continue                    # section 1's territory
  ci=${cpu%.*}; [ "${ci:-0}" -ge "$HOT_CPU" ] || continue
  secs=$(cpusecs "$ctime"); [ "${secs:-0}" -ge "$SPIN_CPU_SECONDS" ] || continue
  echo "$ucomm" | grep -qE "$NEVER_SPIN" && continue
  cwd=$(lsof -p "$pid" -a -d cwd 2>/dev/null | tail -1 | awk '{print $NF}')
  queue "$pid" "spinning $(hms "$secs") of CPU — $(echo "$ucomm" | short)${cwd:+ [$(echo "$cwd" | sed "s|$HOME|~|")]}"
  found_any=1
  # A spinner is often the child of a thin supervisor that would just restart
  # it. Take the parent too, but only when it is plainly a leftover wrapper:
  # orphaned itself and doing nothing.
  pcpu_p=$(cpu_of "$ppid"); pcpu_p=${pcpu_p%.*}
  if [ "$(ppid_of "$ppid")" = "1" ] && [ "${pcpu_p:-0}" -le 2 ]; then
    queue "$ppid" "  idle wrapper of $pid ($(comm_of "$ppid" | short))"
  fi
done < <(ps -U "$(id -un)" -o pid=,ppid=,pcpu=,time=,ucomm= -r)
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 2. leaked / orphaned MCP + automation servers ------------------------
hdr "2. Leaked automation servers  ${DIM}(MCP servers whose owner is gone)${NC}"
found_any=0
for pid in $(pgrep -f "$MCP_PATTERNS" 2>/dev/null); do
  alive "$pid" || continue
  pp=$(ppid_of "$pid")
  root=$(root_of "$pid")
  # leak if orphaned, or if the root ancestor is no longer alive
  if [ "$pp" = "1" ] || { [ -n "$root" ] && ! alive "$root"; }; then
    queue "$pid" "orphaned MCP server ($(comm_of "$pid" | short))"
    found_any=1
  fi
done
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 2b. duplicate MCP servers under one supervisor -----------------------
hdr "2b. Duplicate MCP servers  ${DIM}(same app spawned many, keeps newest)${NC}"
found_any=0
# bash 3.2 (macOS default) has no associative arrays, so build a plain
# "rootpid<TAB>signature<TAB>pid" table and group it with sort/awk.
# Group by the SUPERVISOR (grandparent), not the root app.
#
# This distinction matters. Every Claude Code session and the Claude app share
# the same root, so grouping by root makes 7 legitimately-separate sessions
# look like 7 duplicates. Their grandparents differ (one per session), while
# a leaking app spawns many servers under ONE shared grandparent. Grandparent
# is what actually separates "one per session" from "leaked pile".
TBL=$(for pid in $(pgrep -f "$MCP_PATTERNS" 2>/dev/null); do
  alive "$pid" || continue
  is_mcp "$pid" || continue                 # skips Chrome/Electron children
  pp=$(ppid_of "$pid"); [ -n "$pp" ] || continue
  gp=$(ppid_of "$pp");  [ -n "$gp" ] || gp=$pp
  sig=$(sig_of "$pid");  [ -n "$sig" ] || sig=$(comm_of "$pid" | short)
  printf '%s\t%s\t%s\n' "$gp" "$sig" "$pid"
done | sort -k1,1 -k2,2 -k3,3n)

# a group = same supervisor + same server signature, appearing more than once
while IFS=$'\t' read -r gp sig; do
  [ -n "$gp" ] || continue
  pids=$(echo "$TBL" | awk -F'\t' -v r="$gp" -v s="$sig" '$1==r && $2==s {print $3}')
  count=$(echo "$pids" | wc -l | tr -d ' ')
  [ "$count" -gt 1 ] || continue
  owner=$(comm_of "$(root_of "$gp")" | short); [ -n "$owner" ] || owner="pid $gp"
  newest=$(echo "$pids" | tail -1)          # highest pid = most recent, keep it
  for pid in $pids; do
    [ "$pid" = "$newest" ] && continue
    alive "$pid" || continue
    ci=$(cpu_of "$pid"); ci=${ci%.*}
    kids=$(pgrep -P "$pid" 2>/dev/null | wc -l | tr -d ' ')
    # only a leak if idle AND holding nothing (no live browser attached)
    [ "${ci:-0}" -le 2 ] && [ "$kids" -eq 0 ] || continue
    found_any=1
    if [ $DUPES -eq 1 ]; then
      queue "$pid" "duplicate $sig under $owner"
    else
      printf "    %s%-7s%s cpu=%-5s age=%-12s duplicate %s under %s ${DIM}(--dupes to kill)${NC}\n" \
        "$BLD" "$pid" "$NC" "$(cpu_of $pid)%" "$(etime_of $pid)" "$sig" "$owner"
      # reported but not queued: killing these needs --dupes
      row "$pid" "$SECTION" "needs-dupes-flag" "$(cpu_of $pid)" "$(etime_of $pid)" "duplicate $sig under $owner"
    fi
  done
done < <(echo "$TBL" | awk -F'\t' 'NF{print $1"\t"$2}' | sort -u)
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 3. headless browsers with no live owner ------------------------------
hdr "3. Stranded headless browsers"
found_any=0
for pid in $(pgrep -f "$HEADLESS_PATTERNS" 2>/dev/null); do
  alive "$pid" || continue
  pp=$(ppid_of "$pid")
  # only consider top-level browser processes (parent isn't itself headless)
  case "$(ps -o command= -p "$pp" 2>/dev/null)" in *chrome-headless-shell*) continue ;; esac
  root=$(root_of "$pid")
  if [ "$pp" = "1" ] || { [ -n "$root" ] && ! alive "$root"; }; then
    queue "$pid" "stranded headless browser (+children)"
    for k in $(pgrep -P "$pid" 2>/dev/null); do queue "$k" "  child of stranded browser"; done
    found_any=1
  fi
done
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 4. zombie app helpers ------------------------------------------------
hdr "4. Zombie app helpers  ${DIM}(app quit, helpers still running)${NC}"
found_any=0
for app in "${ZOMBIE_APPS[@]}"; do
  pgrep -x "$app" >/dev/null 2>&1 && continue     # app is open, helpers expected
  for pid in $(pgrep -f "/$app\.app/.*(crashpad|Helper|gpu-process|utility|renderer)" 2>/dev/null); do
    queue "$pid" "$app zombie helper (app is closed)"
    found_any=1
  done
done
[ $found_any -eq 0 ] && echo "  ${GRN}none${NC}"
flush_kills

# ---- 5. idle Claude Code sessions — REPORT ONLY ---------------------------
if [ $SHOW_SESSIONS -eq 1 ]; then
  hdr "5. Claude Code sessions  ${DIM}(report only — never killed by this script)${NC}"
  now=$(date +%s); any=0
  for pid in $(pgrep -f "claude-code/.*MacOS/claude" 2>/dev/null); do
    # pgrep -f also matches the Helpers/disclaimer wrapper (the claude path is
    # in its argv). Keep only processes that ARE the claude binary.
    case "$(ps -o comm= -p "$pid" 2>/dev/null)" in
      */claude.app/Contents/MacOS/claude) ;;
      *) continue ;;
    esac
    cwd=$(lsof -p "$pid" -a -d cwd 2>/dev/null | tail -1 | awk '{print $NF}')
    [ -n "$cwd" ] || continue
    d="$HOME/.claude/projects/$(echo "$cwd" | sed 's|[/.]|-|g')"
    newest=$(ls -t "$d"/*.jsonl 2>/dev/null | head -1)
    if [ -n "$newest" ]; then
      mins=$(( (now - $(stat -f %m "$newest")) / 60 ))
      idle=$(printf "%dh %02dm" $((mins/60)) $((mins%60)))
      if [ "$mins" -ge "$IDLE_SESSION_MINS" ]; then tag="${YLW}idle $idle${NC}"; else tag="${GRN}active $idle ago${NC}"; fi
    else
      tag="${DIM}unknown${NC}"; mins=0
    fi
    printf "    %-7s %-22s %s\n" "$pid" "$tag" "$(basename "$cwd")"
    row "$pid" "$SECTION" "never-killed" "$(cpu_of $pid)" "$(etime_of "$pid")" "Claude Code session in $(basename "$cwd"), idle ${mins}m"
    any=1
  done
  [ $any -eq 0 ] && echo "  ${GRN}none${NC}"
  echo "  ${DIM}Idle time is per worktree — two sessions in the same worktree share it.${NC}"
  echo "  ${DIM}To close one: switch to it in the Claude app and quit it there.${NC}"
  echo "  ${DIM}This script will not kill sessions — you'd lose unsaved work.${NC}"
fi

# ---- summary --------------------------------------------------------------
echo
if [ "$MODE" = kill ]; then
  echo "${BLD}Done.${NC} killed ${RED}$KILLED${NC} process(es). log: ${DIM}$LOG${NC}"
  echo "${DIM}new load: $(uptime | sed 's/.*load averages*: //')${NC}"
else
  if [ $FOUND -eq 0 ]; then
    echo "${GRN}${BLD}Clean.${NC} nothing to reap."
  else
    echo "${BLD}Found $FOUND reapable process(es).${NC} run ${BLD}machogs kill${NC} to clean up."
  fi
fi
[ "$swap_pct" -gt 80 ] && echo "${YLW}Note:${NC} swap is ${swap_pct}% full — a restart is the only real fix for that."

# ---- machine-readable output ----------------------------------------------
# Restore the real stdout parked on fd 4 and print exactly one JSON object.
if [ "$JSON" -eq 1 ]; then
  exec 1>&4 4>&-
  printf '{\n'
  printf '  "mode": "%s",\n' "$MODE"
  printf '  "host": {"load": %s, "cores": %s, "swap_used_mb": %s, "swap_total_mb": %s, "swap_pct": %s, "uptime_days": %s},\n' \
    "${load:-0}" "${cores:-0}" "${swap_used:-0}" "${swap_tot:-0}" "${swap_pct:-0}" \
    "$(uptime | sed -n 's/.*up \([0-9]*\) day.*/\1/p' | head -1 | grep -E '^[0-9]+$' || echo 0)"
  printf '  "summary": {"reapable": %s, "killed": %s},\n' "$FOUND" "$KILLED"
  printf '  "findings": [\n'
  first=1
  while IFS=$'\t' read -r p sec act cpu age detail csec; do
    [ -n "$p" ] || continue
    # a queued process that flush_kills actually reaped is reported as killed
    case " $KILLED_PIDS " in *" $p "*) act="killed" ;; esac
    [ $first -eq 1 ] || printf ',\n'
    first=0
    # `story` is the line meant to be said out loud, verbatim. Without it every
    # agent writes its own and most of them are flat.
    st=$(story "$sec" "$(whatis "$p")" "$(whose "$p")" 1 "${cpu:-0}" "$age" "${csec:-0}")
    printf '    {"pid": %s, "section": "%s", "action": "%s", "cpu": %s, "cpu_seconds": %s, "age": "%s", "detail": "%s", "story": "%s"}' \
      "$p" "$(jesc "$sec")" "$(jesc "$act")" "${cpu:-0}" "${csec:-0}" "$(jesc "$age")" "$(jesc "$detail")" "$(jesc "$st")"
  done < "$ROWS"
  [ $first -eq 0 ] && printf '\n'
  printf '  ]\n}\n'
fi

# ---- plain-language report and guided fix ---------------------------------
if [ "$HUMAN" -eq 1 ]; then
  exec 1>&4 4>&-

  # `kill` has already done the closing by now, so the findings it acted on are
  # dead and would filter out below — which read as "nothing found" right after
  # closing two things. Report the receipt instead.
  if [ "$MODE" = kill ]; then
    if [ "$KILLED" -gt 0 ]; then
      receipt "$FREED_CPU" "$FREED_CSEC" "$KILLED"
    else
      echo
      echo "${GRN}Nothing to close.${NC}"
    fi
    if [ "$swap_pct" -gt 80 ]; then
      echo
      echo "${YLW}Note:${NC} your Mac is out of fast memory after $(uptime | sed -n 's/.*up \([0-9]*\) day.*/\1/p' | head -1) days on."
      echo "Closing programs does not fix that. ${BLD}Restart when you can.${NC}"
    fi
    echo
    exit 0
  fi

  # everything the person could act on; sessions are informational only
  CANDIDATES=$(awk -F'\t' '$3=="reapable" || $3=="needs-dupes-flag"' "$ROWS")
  n=$(printf '%s' "$CANDIDATES" | grep -c . || true)

  echo
  if [ "${n:-0}" -eq 0 ]; then
    echo "${GRN}${BLD}Nothing is hogging your Mac.${NC}"
    echo "No stuck or abandoned programs are running."
    if [ "$swap_pct" -gt 80 ]; then
      echo
      echo "${YLW}But your Mac has run out of fast memory.${NC}"
      echo "It has been on for $(uptime | sed -n 's/.*up \([0-9]*\) day.*/\1/p' | head -1) days and is now"
      echo "shuffling memory to disk, which makes everything slow."
      echo "${BLD}Restart it.${NC} That is the only thing that fixes this."
    elif [ "${loadint:-0}" -gt "$cores" ]; then
      echo
      echo "Your Mac is busy, but every program running is one you are using."
      echo "Close a few apps or browser tabs."
    else
      echo "If it still feels slow or hot, the cause is something else —"
      echo "check for a big download, a backup, or Spotlight rebuilding."
    fi
  else
    # Group identical findings. Key = section + what it is + who left it.
    # Aggregate: how many, the worst CPU in the group, the oldest age, the pids.
    ENR=$(mktemp -t machogs-enr) || exit 1
    while IFS=$'\t' read -r p sec act cpu age detail csec; do
      [ -n "$p" ] || continue
      alive "$p" || continue
      # "-" not "": tab is IFS whitespace, so bash COLLAPSES an empty field and
      # every column after it shifts left. That reads as a working script right
      # up until it compares a timestamp against a number.
      o=$(whose "$p"); [ -n "$o" ] || o="-"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$sec" "$(whatis "$p")" "$o" "$cpu" "$age" "${csec:-0}" "$p" >> "$ENR"
    done < <(printf '%s\n' "$CANDIDATES")
    # Two things that will silently eat the rest of this block if you put them
    # back: a heredoc inside $( ), and a nested $( ) inside this multi-line
    # substitution. Both cost an hour to find. TAB is a plain variable for
    # exactly that reason.
    awk -F'\t' '
      { k=$1 "\t" $2 "\t" $3
        cnt[k]++
        if (!(k in cpu)) { cpu[k]=0; scpu[k]=0; scsec[k]=0 }
        if ($4+0 > cpu[k]+0) cpu[k]=$4+0
        scpu[k]  += $4+0          # total CPU% the whole group is holding
        scsec[k] += $6+0          # total CPU seconds the group has burned
        if (length($5) > length(age[k]) || (length($5)==length(age[k]) && $5>age[k])) age[k]=$5
        pids[k] = (k in pids ? pids[k] " " : "") $7 }
      END { for (k in cnt) printf "%s\t%d\t%s\t%s\t%.1f\t%d\t%s\n",
              k, cnt[k], cpu[k], age[k], scpu[k], scsec[k], pids[k] }
    ' "$ENR" | sort -t"$TAB" -k5,5nr > "$GRP"
    rm -f "$ENR"
    ngroups=$(wc -l < "$GRP" | tr -d ' ')
    # is anything actually burning CPU, or is this all idle clutter?
    hot=$(awk -F'\t' '$5+0 >= 20' "$GRP" | wc -l | tr -d ' ')

    if [ "$MODE" = fix ]; then
      echo "${BLD}Found ${ngroups} thing(s) worth closing.${NC}"
      echo "${DIM}I will ask before each one. Nothing closes unless you say yes.${NC}"
    elif [ "${hot:-0}" -gt 0 ]; then
      echo "${BLD}Something is hogging your Mac.${NC}"
    else
      echo "${BLD}Nothing is eating your CPU right now.${NC}"
      echo "${DIM}But ${n} abandoned program(s) are sitting in memory.${NC}"
    fi
    echo

    i=0; closed=0; freed_cpu=0; freed_csec=0
    while IFS=$'\t' read -r sec what owner count cpu age scpu scsec pidlist; do
      [ -n "$sec" ] || continue
      i=$((i+1))
      [ "$MODE" = fix ] && echo "${DIM}${i} of ${ngroups}${NC}"
      say_group "$sec" "$what" "$owner" "$count" "$cpu" "$age"
      if [ "$MODE" = fix ]; then
        echo
        if [ "$count" -gt 1 ]; then
          printf "  Close all %s? [y/N] " "$count"
        else
          printf "  Close it? [y/N] "
        fi
        read -r ans </dev/tty
        case "$ans" in
          y|Y|yes|YES)
            for p in $pidlist; do
              alive "$p" || continue
              if kill -9 "$p" 2>/dev/null; then
                closed=$((closed+1))
                logclose "$p" "$owner" "$what" "$cpu" "$scsec"
              fi
            done
            freed_cpu=$(awk -v a="$freed_cpu" -v b="$scpu" 'BEGIN{printf "%.1f", a+b}')
            freed_csec=$((freed_csec + scsec))
            echo "  ${GRN}Closed.${NC}" ;;
          *) echo "  ${DIM}Left alone.${NC}" ;;
        esac
      fi
      echo
    done < "$GRP"

    if [ "$MODE" = fix ]; then
      if [ "$closed" -gt 0 ]; then
        receipt "$freed_cpu" "$freed_csec" "$closed"
        [ "${hot:-0}" -gt 0 ] && echo "Your fan should quiet down over the next few minutes."
      else
        echo "${DIM}Nothing was closed.${NC}"
      fi
    else
      # Only claim the symptoms something is actually causing.
      if [ "${hot:-0}" -gt 0 ]; then
        echo "${BLD}This is why your Mac feels slow, runs hot, spins its fan,${NC}"
        echo "${BLD}and loses battery faster than it should.${NC}"
      else
        echo "These are not making your fan spin — none of them are busy."
        echo "They waste memory, which matters once memory runs short."
      fi
      echo
      echo "To go through them one at a time:  ${BLD}machogs fix${NC}"
      echo "${DIM}Nothing is closed unless you say yes.${NC}"
    fi

    if [ "$swap_pct" -gt 80 ]; then
      echo
      echo "${YLW}Also:${NC} your Mac has been on for $(uptime | sed -n 's/.*up \([0-9]*\) day.*/\1/p' | head -1) days and is out of fast memory."
      echo "Closing programs will not fix that part. ${BLD}Restart when you can.${NC}"
    fi
  fi
  echo

  # kills in fix mode are counted here, not by flush_kills
  KILLED=$((KILLED + ${closed:-0}))
  if [ "$MODE" = report ] && [ "${n:-0}" -gt 0 ]; then exit 10; fi
  exit 0
fi

# Exit code is the verdict, so a caller need not parse anything at all.
#   0  clean, or a kill run that finished
#  10  report mode with findings a human should look at
if [ "$MODE" = report ] && [ "$FOUND" -gt 0 ]; then exit 10; fi
exit 0
